<section class="panel dsa5h-body-panel"><div class="panel-title flex"><span>{{localize 'DSA5HELPERS.BodyEquipment'}}</span>{{#if (or prepare.magic.hasSpells prepare.magic.hasPrayers)}}<span class="dsa5h-cast-btns">{{#if prepare.magic.hasSpells}}<button type="button" class="dsa5h-cast-btn" data-action="dsa5hOpenCast" data-kind="spell" aria-haspopup="dialog"><span aria-hidden="true">✦</span>{{localize 'DSA5HELPERS.CastSpells'}}</button>{{/if}}{{#if prepare.magic.hasPrayers}}<button type="button" class="dsa5h-cast-btn" data-action="dsa5hOpenCast" data-kind="liturgy" aria-haspopup="dialog"><span aria-hidden="true">☀</span>{{localize 'DSA5HELPERS.CastLiturgies'}}</button>{{/if}}</span>{{/if}}</div>
{{!-- Ganz oben: Schnellaktionen und Initiative (Issue #29, Rückmeldung 2026-10-02). --}}
<div class="dsa5h-body-top">{{> "modules/dsa5-helpers/templates/actors/parts/quick-actions.hbs"}}<div class="dsa5h-body-ini"><span class="dsa5h-body-stat"><small>{{localize 'initiative'}}</small><strong>{{dsa5h.body.initiative}}</strong></span></div></div>
<div class="dsa5h-body-grid sides{{#if dsa5h.body.zones}} armor-zones{{/if}}{{#if dsa5h.body.freeSide}} free-{{dsa5h.body.freeSide}}{{/if}}"><img class="dsa5h-body-figure" src="{{dsa5h.body.figure}}" alt="" aria-hidden="true">
{{#if dsa5h.editMode}}<div class="dsa5h-body-seg dsa5h-body-figure-switch" role="group" aria-label="{{localize 'DSA5HELPERS.BodyFigure'}}"><button type="button" data-action="dsa5hBodyFigure" data-figure="placeholder" class="{{#unless dsa5h.body.portrait}}active{{/unless}}" aria-pressed="{{#if dsa5h.body.portrait}}false{{else}}true{{/if}}">{{localize 'DSA5HELPERS.BodyFigurePlaceholder'}}</button><button type="button" data-action="dsa5hBodyFigure" data-figure="portrait" class="{{#if dsa5h.body.portrait}}active{{/if}}" aria-pressed="{{#if dsa5h.body.portrait}}true{{else}}false{{/if}}">{{localize 'DSA5HELPERS.BodyFigurePortrait'}}</button></div>{{/if}}
{{!-- Hände links und rechts der Figur (Issue #29): Haupthand links, Nebenhand rechts; eine beidhändige Waffe auf der gewählten Seite. --}}
<div class="dsa5h-body-side left">{{> "modules/dsa5-helpers/templates/actors/parts/body-hand.hbs" side=dsa5h.body.left}}</div>
{{!-- Rüstung mittig über der Figur (Issue #36, Nutzer-Entscheidung 2026-10-20 „Wappenschild“): Gesamtschutz auf dem Bild
     der Hauptrüstung, ihr Name als Band darunter, weitere Teile nur bei mehr als einem (Bearbeiten-Modus: Klick wählt die
     Hauptrüstung). Mit Trefferzonen-Regel ein Zonenkreuz mit RS je Zone. Smartphone: Rüstungszeile unten (Sprungmarke). --}}
{{#unless dsa5h.phone}}{{#if dsa5h.body.zones}}<div class="dsa5h-armor-center dsa5h-armor-center-zones"><div class="dsa5h-armor-zone-cross">{{#each dsa5h.body.zones as |zone|}}{{#if zone.energy}}<div class="dsa5h-energy-zone dsa5h-zone-{{zone.key}}{{#if zone.energy.failed}} failed{{/if}}">{{/if}}{{#if zone.itemId}}<button type="button" class="dsa5h-armor-zone{{#unless zone.energy}} dsa5h-zone-{{zone.key}}{{/unless}} item" data-item-id="{{zone.itemId}}" data-action="itemEdit" data-tooltip="{{zone.tooltip}}" aria-label="{{zone.label}}: {{zone.names}}, {{localize 'CHARAbbrev.RS'}} {{zone.rs}}"><img src="{{zone.img}}" alt="">{{else}}<div class="dsa5h-armor-zone{{#unless zone.energy}} dsa5h-zone-{{zone.key}}{{/unless}} empty" data-tooltip="{{zone.tooltip}}" aria-label="{{zone.label}}: {{localize 'DSA5HELPERS.NoArmor'}}">{{/if}}<span class="dsa5h-armor-zone-label"><span class="dsa5h-zl-short">{{zone.short}}</span><span class="dsa5h-zl-long">{{zone.label}}</span></span><span class="dsa5h-armor-zone-item">{{#if zone.names}}{{zone.names}}{{else}}{{localize 'DSA5HELPERS.NoArmor'}}{{/if}}</span><strong>{{#if zone.rs}}{{zone.rs}}{{else}}–{{/if}}</strong>{{#if zone.itemId}}</button>{{else}}</div>{{/if}}{{#if zone.energy}}{{> "modules/dsa5-helpers/templates/actors/parts/energy-zone.hbs" zone=zone}}</div>{{/if}}{{/each}}</div>
<div class="dsa5h-armor-sum-bar" tabindex="0" data-tooltip="{{dsa5h.body.armorTooltip}}" aria-label="{{localize 'encumbrance'}} {{dsa5h.body.encumbrance}}"><span><small>{{localize 'DSA5HELPERS.EncumbranceAbbr'}}</small><strong>{{dsa5h.body.encumbrance}}</strong></span>{{#if dsa5h.body.magicArmor}}<span><small>{{localize 'DSA5HELPERS.MagicArmorShort'}}</small><strong>+{{dsa5h.body.magicArmor}}</strong></span>{{/if}}</div></div>
{{else}}<div class="dsa5h-armor-center dsa5h-armor-center-crest">{{#with dsa5h.body.mainArmor as |main|}}<div class="dsa5h-armor-crest-group item" data-item-id="{{main._id}}"><button type="button" class="dsa5h-armor-crest withContext" data-action="itemEdit" data-tooltip="{{@root.dsa5h.body.armorTooltip}}" aria-label="{{main.name}} — {{localize 'protection'}} {{@root.prepare.armorSum}}, {{localize 'encumbrance'}} {{@root.dsa5h.body.encumbrance}}"><img class="dsa5h-armor-crest-img" src="{{main.img}}" alt=""><span class="dsa5h-armor-crest-rs"><small>{{localize 'CHARAbbrev.RS'}}</small><strong>{{@root.prepare.armorSum}}</strong>{{#if @root.dsa5h.body.magicArmor}}<small class="dsa5h-armor-sum-magic">+{{@root.dsa5h.body.magicArmor}}</small>{{/if}}</span><span class="dsa5h-armor-crest-be"><small>{{localize 'DSA5HELPERS.EncumbranceAbbr'}}</small><strong>{{@root.dsa5h.body.encumbrance}}</strong></span></button>{{#if main.OnUseEffect}}{{> "modules/dsa5-helpers/templates/actors/parts/onuse.hbs" name=main.name}}{{/if}}<div class="dsa5h-armor-crest-name">{{main.name}}</div></div>{{else}}<div class="dsa5h-armor-crest-group"><div class="dsa5h-armor-crest empty"><span class="dsa5h-armor-crest-rs"><small>{{localize 'CHARAbbrev.RS'}}</small><strong>{{prepare.armorSum}}</strong>{{#if dsa5h.body.magicArmor}}<small class="dsa5h-armor-sum-magic">+{{dsa5h.body.magicArmor}}</small>{{/if}}</span></div><div class="dsa5h-armor-crest-name">{{localize 'DSA5HELPERS.NoArmor'}}</div></div>{{/with}}
{{#if dsa5h.body.extraArmor.length}}<div class="dsa5h-armor-extras">{{#each dsa5h.body.extraArmor as |entry|}}{{#with entry.item as |item|}}<div class="dsa5h-armor-extra item" data-item-id="{{item._id}}"><button type="button" class="dsa5h-armor-extra-main withContext" data-action="{{#if @root.dsa5h.editMode}}dsa5hMainArmor{{else}}itemEdit{{/if}}" data-tooltip="{{entry.tooltip}}{{#if @root.dsa5h.editMode}}<br>{{localize 'DSA5HELPERS.MainArmorPick'}}{{/if}}" aria-label="{{item.name}}{{#if @root.dsa5h.editMode}}: {{localize 'DSA5HELPERS.MainArmorPick'}}{{/if}}"><img src="{{item.img}}" alt=""><span class="dsa5h-armor-extra-name">{{item.name}}</span><span class="dsa5h-armor-extra-rs">{{localize 'CHARAbbrev.RS'}} {{item.system.protection.value}}</span></button>{{#if item.OnUseEffect}}{{> "modules/dsa5-helpers/templates/actors/parts/onuse.hbs" name=item.name}}{{/if}}</div>{{/with}}{{/each}}{{#if dsa5h.editMode}}<small class="dsa5h-armor-extras-hint">{{localize 'DSA5HELPERS.MainArmorHint'}}</small>{{/if}}</div>{{/if}}</div>{{/if}}{{/unless}}
<div class="dsa5h-body-side right{{#if dsa5h.body.offFree}} off-free{{/if}}">{{> "modules/dsa5-helpers/templates/actors/parts/body-hand.hbs" side=dsa5h.body.right}}</div>
</div>
{{!-- Smartphone: Rüstungskacheln unter den Händen mit eigener Sprungmarke, das Schild mit Rüstungsschutz/Belastung; der
     Tooltip schlüsselt beides je Rüstungsteil auf (Issue #29). Desktop/Tablet: Rüstung mittig (oben, Issue #36). --}}
{{#if dsa5h.phone}}<div class="dsa5h-body-armor-row" data-sub-panel="combat:armor"><small class="dsa5h-figure-col-title">{{localize 'Equipment.armor'}}</small>
{{#if dsa5h.body.armor.length}}<div class="dsa5h-body-armor">{{#each dsa5h.body.armor as |item|}}<div class="dsa5h-body-armor-item item" data-item-id="{{item._id}}"><span class="dsa5h-body-item-name withContext" data-tooltip="{{item.name}}"><a data-action="itemEdit">{{item.name}}</a></span><div class="dsa5h-armor-slot"><img class="dsa5h-armor-slot-image" src="{{item.img}}" alt="">{{#if item.OnUseEffect}}{{> "modules/dsa5-helpers/templates/actors/parts/onuse.hbs" name=item.name}}{{/if}}{{#if item.structureMax}}<meter min="0" max="{{item.structureMax}}" value="{{item.structureCurrent}}"></meter>{{/if}}<span class="dsa5h-armor-slot-rs" title="{{localize 'protection'}}">{{localize 'CHARAbbrev.RS'}} {{item.system.protection.value}}</span><span class="dsa5h-armor-slot-be" title="{{localize 'encumbrance'}}">{{localize 'DSA5HELPERS.EncumbranceAbbr'}} {{item.system.calculatedEncumbrance}}</span></div></div>{{/each}}</div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.NoArmorWorn'}}</p>{{/if}}<div class="dsa5h-body-shield" tabindex="0" data-tooltip="{{dsa5h.body.armorTooltip}}" data-tooltip-direction="LEFT" aria-label="{{localize 'protection'}} {{prepare.armorSum}}, {{localize 'encumbrance'}} {{dsa5h.body.encumbrance}}"><span class="dsa5h-body-shield-rs"><small>{{localize 'CHARAbbrev.RS'}}</small><strong>{{prepare.armorSum}}</strong>{{#if dsa5h.body.magicArmor}}<small class="dsa5h-body-shield-magic">+{{dsa5h.body.magicArmor}}</small>{{/if}}</span><span class="dsa5h-body-shield-be"><small>{{localize 'DSA5HELPERS.EncumbranceAbbr'}}</small><strong>{{dsa5h.body.encumbrance}}</strong></span></div></div>{{/if}}
{{#if dsa5h.phone}}{{#if dsa5h.body.zones}}<div class="dsa5h-phone-energy-zones">{{#each dsa5h.body.zones as |zone|}}{{#if zone.energy}}<div class="dsa5h-energy-zone{{#if zone.energy.failed}} failed{{/if}}"><span>{{zone.label}}</span>{{> "modules/dsa5-helpers/templates/actors/parts/energy-zone.hbs" zone=zone}}</div>{{/if}}{{/each}}</div>{{/if}}{{/if}}
</section>
{{#if dsa5h.body.others.length}}<section class="panel dsa5h-short-weapons-panel"><div class="panel-title">{{localize 'DSA5HELPERS.OtherWeapons'}}</div><div class="dsa5h-short-weapons">{{#each dsa5h.body.others}}{{> "modules/dsa5-helpers/templates/actors/parts/weapon-short.hbs" item=item ranged=ranged equip=equip container=container}}{{/each}}</div></section>{{/if}}
{{!-- Grundmanöver (Hausregel Paladose, #45/#48): Stufe je Leiteigenschaft, Verteidigungshaltung, Zielen und Schwachpunkte erkennen; die Manöver selbst wählt man im Probendialog. --}}
{{#if dsa5h.maneuvers}}<section class="panel dsa5h-maneuvers"><div class="panel-title flex"><span>{{localize 'DSA5HELPERS.HouseRules.maneuvers.Block'}}</span><button type="button" class="dsa5h-maneuvers-book" data-action="dsa5hOpenManeuvers"><i class="fas fa-book-open" inert></i> {{localize 'DSA5HELPERS.HouseRules.maneuvers.OpenBook'}}</button></div>
<p class="dsa5h-panel-note">{{localize 'DSA5HELPERS.HouseRules.maneuvers.BlockHint'}}</p>
<div class="dsa5h-maneuver-rows">{{#each dsa5h.maneuvers.rows}}<div class="dsa5h-maneuver-row"><i class="{{icon}}" inert></i><span class="dsa5h-maneuver-name">{{name}}</span><small>{{attr}}</small><strong>{{value}}</strong></div>{{/each}}</div>
{{#if (or dsa5h.maneuvers.stance dsa5h.maneuvers.aim dsa5h.maneuvers.advanceMalus dsa5h.maneuvers.weakness)}}<div class="dsa5h-maneuver-actions">
{{#if dsa5h.maneuvers.stance}}<button type="button" class="dsa5h-maneuver-btn{{#if dsa5h.maneuvers.stance.active}} active{{/if}}" data-action="dsa5hStance" aria-pressed="{{#if dsa5h.maneuvers.stance.active}}true{{else}}false{{/if}}"><i class="fas fa-shield-halved" inert></i> {{#if dsa5h.maneuvers.stance.active}}{{localize 'DSA5HELPERS.HouseRules.maneuvers.stance.On'}}{{else}}{{localize 'DSA5HELPERS.HouseRules.maneuvers.stance.Off'}}{{/if}}</button>{{/if}}
{{#if dsa5h.maneuvers.aim}}<button type="button" class="dsa5h-maneuver-btn{{#if dsa5h.maneuvers.aim.count}} active{{/if}}" data-action="dsa5hAimRound" {{#unless dsa5h.maneuvers.aim.inCombat}}disabled data-tooltip="DSA5HELPERS.HouseRules.maneuvers.aim.NoCombat"{{/unless}}><i class="fas fa-bullseye" inert></i> {{localize 'DSA5HELPERS.HouseRules.maneuvers.aim.Status' count=dsa5h.maneuvers.aim.count max=dsa5h.maneuvers.aim.max}}</button>{{/if}}
{{#if dsa5h.maneuvers.weakness}}<button type="button" class="dsa5h-maneuver-btn{{#if dsa5h.maneuvers.weakness.entries.length}} active{{/if}}" data-action="dsa5hWeakness" {{#if dsa5h.maneuvers.weakness.inCombat}}data-tooltip="DSA5HELPERS.HouseRules.maneuvers.weakness.ButtonHint"{{else}}disabled data-tooltip="DSA5HELPERS.HouseRules.maneuvers.weakness.NoCombat"{{/if}}><i class="fas fa-magnifying-glass" inert></i> {{localize 'DSA5HELPERS.HouseRules.maneuvers.weakness.Button'}}</button>{{#each dsa5h.maneuvers.weakness.entries}}<span class="dsa5h-maneuver-status dsa5h-maneuver-weakness"><i class="fas fa-magnifying-glass" inert></i> {{text}}</span>{{/each}}{{/if}}
{{#if dsa5h.maneuvers.advanceMalus}}<span class="dsa5h-maneuver-status"><i class="fas fa-person-running" inert></i> {{localize 'DSA5HELPERS.HouseRules.maneuvers.advance.Status' malus=dsa5h.maneuvers.advanceMalus}}</span>{{/if}}
</div>{{/if}}</section>{{/if}}
{{> "modules/dsa5-helpers/templates/actors/parts/specs.hbs" groups=dsa5h.specs.combat}}
{{#if prepare.magic.hasSpells}}<dialog class="dsa5h-cast-dialog" data-cast-dialog="spell" aria-label="{{localize 'DSA5HELPERS.CastSpellsTitle'}}"><section class="panel"><div class="panel-title flex"><span>{{localize 'DSA5HELPERS.CastSpellsTitle'}}</span><button type="button" data-action="dsa5hCloseCast" aria-label="{{localize 'DSA5HELPERS.Close'}}">✕</button></div>{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="spells" items=prepare.magic.spellList}}{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="rituals" items=prepare.magic.ritualList}}</section>{{> "modules/dsa5-helpers/templates/actors/parts/chips.hbs" title="magictricks" items=prepare.magic.magictrick}}</dialog>{{/if}}
{{#if prepare.magic.hasPrayers}}<dialog class="dsa5h-cast-dialog" data-cast-dialog="liturgy" aria-label="{{localize 'DSA5HELPERS.CastLiturgiesTitle'}}"><section class="panel"><div class="panel-title flex"><span>{{localize 'DSA5HELPERS.CastLiturgiesTitle'}}</span><button type="button" data-action="dsa5hCloseCast" aria-label="{{localize 'DSA5HELPERS.Close'}}">✕</button></div>{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="liturgies" items=prepare.magic.liturgy}}{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="ceremonies" items=prepare.magic.ceremony}}</section>{{> "modules/dsa5-helpers/templates/actors/parts/chips.hbs" title="blessings" items=prepare.magic.blessing}}</dialog>{{/if}}
