<section class="panel dsa5h-body-panel"><div class="panel-title flex"><span>{{localize 'DSA5HELPERS.BodyEquipment'}}</span>{{#if (or prepare.magic.hasSpells prepare.magic.hasPrayers)}}<span class="dsa5h-cast-btns">{{#if prepare.magic.hasSpells}}<button type="button" class="dsa5h-cast-btn" data-action="dsa5hOpenCast" data-kind="spell" aria-haspopup="dialog"><span aria-hidden="true">✦</span>{{localize 'DSA5HELPERS.CastSpells'}}</button>{{/if}}{{#if prepare.magic.hasPrayers}}<button type="button" class="dsa5h-cast-btn" data-action="dsa5hOpenCast" data-kind="liturgy" aria-haspopup="dialog"><span aria-hidden="true">☀</span>{{localize 'DSA5HELPERS.CastLiturgies'}}</button>{{/if}}</span>{{/if}}</div>
{{!-- Ganz oben: Schnellaktionen und Initiative (Issue #29, Rückmeldung 2026-10-02). --}}
<div class="dsa5h-body-top">{{> "modules/dsa5-helpers/templates/actors/parts/quick-actions.hbs"}}<div class="dsa5h-body-ini"><span class="dsa5h-body-stat"><small>{{localize 'initiative'}}</small><strong>{{dsa5h.body.initiative}}</strong></span></div></div>
<div class="dsa5h-body-grid sides"><img class="dsa5h-body-figure" src="{{dsa5h.body.figure}}" alt="" aria-hidden="true">
{{#if dsa5h.editMode}}<div class="dsa5h-body-seg dsa5h-body-figure-switch" role="group" aria-label="{{localize 'DSA5HELPERS.BodyFigure'}}"><button type="button" data-action="dsa5hBodyFigure" data-figure="placeholder" class="{{#unless dsa5h.body.portrait}}active{{/unless}}" aria-pressed="{{#if dsa5h.body.portrait}}false{{else}}true{{/if}}">{{localize 'DSA5HELPERS.BodyFigurePlaceholder'}}</button><button type="button" data-action="dsa5hBodyFigure" data-figure="portrait" class="{{#if dsa5h.body.portrait}}active{{/if}}" aria-pressed="{{#if dsa5h.body.portrait}}true{{else}}false{{/if}}">{{localize 'DSA5HELPERS.BodyFigurePortrait'}}</button></div>{{/if}}
{{!-- Hände links und rechts der Figur (Issue #29): Haupthand links, Nebenhand rechts; eine beidhändige Waffe auf der gewählten Seite. --}}
<div class="dsa5h-body-side left">{{> "modules/dsa5-helpers/templates/actors/parts/body-hand.hbs" side=dsa5h.body.left}}</div>
<div class="dsa5h-body-side right{{#if dsa5h.body.offFree}} off-free{{/if}}">{{> "modules/dsa5-helpers/templates/actors/parts/body-hand.hbs" side=dsa5h.body.right}}</div>
</div>
{{!-- Rüstungskacheln unter der Figur, rechtsbündig das Schild mit Rüstungsschutz/Belastung; der Tooltip schlüsselt beides
     je Rüstungsteil auf (Issue #29, Nutzer-Entscheidung 2026-10-02). --}}
<div class="dsa5h-body-armor-row"><small class="dsa5h-figure-col-title">{{localize 'Equipment.armor'}}</small>
{{#if dsa5h.body.armor.length}}<div class="dsa5h-body-armor">{{#each dsa5h.body.armor as |item|}}<div class="dsa5h-body-armor-item item" data-item-id="{{item._id}}"><span class="dsa5h-body-item-name withContext" data-tooltip="{{item.name}}"><a data-action="itemEdit">{{item.name}}</a></span><div class="dsa5h-armor-slot"><img class="dsa5h-armor-slot-image" src="{{item.img}}" alt="">{{#if item.OnUseEffect}}{{> "modules/dsa5-helpers/templates/actors/parts/onuse.hbs" name=item.name}}{{/if}}{{#if item.structureMax}}<meter min="0" max="{{item.structureMax}}" value="{{item.structureCurrent}}"></meter>{{/if}}<span class="dsa5h-armor-slot-rs" title="{{localize 'protection'}}">{{localize 'CHARAbbrev.RS'}} {{item.system.protection.value}}</span><span class="dsa5h-armor-slot-be" title="{{localize 'encumbrance'}}">{{localize 'DSA5HELPERS.EncumbranceAbbr'}} {{item.system.calculatedEncumbrance}}</span></div></div>{{/each}}</div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.NoArmorWorn'}}</p>{{/if}}<div class="dsa5h-body-shield" tabindex="0" data-tooltip="{{dsa5h.body.armorTooltip}}" data-tooltip-direction="LEFT" aria-label="{{localize 'protection'}} {{prepare.armorSum}}, {{localize 'encumbrance'}} {{dsa5h.body.encumbrance}}"><span class="dsa5h-body-shield-rs"><small>{{localize 'CHARAbbrev.RS'}}</small><strong>{{prepare.armorSum}}</strong>{{#if dsa5h.body.magicArmor}}<small class="dsa5h-body-shield-magic">+{{dsa5h.body.magicArmor}}</small>{{/if}}</span><span class="dsa5h-body-shield-be"><small>{{localize 'DSA5HELPERS.EncumbranceAbbr'}}</small><strong>{{dsa5h.body.encumbrance}}</strong></span></div></div>
</section>
{{#if dsa5h.body.others.length}}<section class="panel dsa5h-short-weapons-panel"><div class="panel-title">{{localize 'DSA5HELPERS.OtherWeapons'}}</div><div class="dsa5h-short-weapons">{{#each dsa5h.body.others}}{{> "modules/dsa5-helpers/templates/actors/parts/weapon-short.hbs" item=item ranged=ranged equip=equip}}{{/each}}</div></section>{{/if}}
{{> "modules/dsa5-helpers/templates/actors/parts/specs.hbs" groups=dsa5h.specs.combat}}
{{#if prepare.magic.hasSpells}}<dialog class="dsa5h-cast-dialog" data-cast-dialog="spell" aria-label="{{localize 'DSA5HELPERS.CastSpellsTitle'}}"><section class="panel"><div class="panel-title flex"><span>{{localize 'DSA5HELPERS.CastSpellsTitle'}}</span><button type="button" data-action="dsa5hCloseCast" aria-label="{{localize 'DSA5HELPERS.Close'}}">✕</button></div>{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="spells" items=prepare.magic.spellList}}{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="rituals" items=prepare.magic.ritualList}}</section>{{> "modules/dsa5-helpers/templates/actors/parts/chips.hbs" title="magictricks" items=prepare.magic.magictrick}}</dialog>{{/if}}
{{#if prepare.magic.hasPrayers}}<dialog class="dsa5h-cast-dialog" data-cast-dialog="liturgy" aria-label="{{localize 'DSA5HELPERS.CastLiturgiesTitle'}}"><section class="panel"><div class="panel-title flex"><span>{{localize 'DSA5HELPERS.CastLiturgiesTitle'}}</span><button type="button" data-action="dsa5hCloseCast" aria-label="{{localize 'DSA5HELPERS.Close'}}">✕</button></div>{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="liturgies" items=prepare.magic.liturgy}}{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="ceremonies" items=prepare.magic.ceremony}}</section>{{> "modules/dsa5-helpers/templates/actors/parts/chips.hbs" title="blessings" items=prepare.magic.blessing}}</dialog>{{/if}}
