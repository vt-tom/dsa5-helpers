<section class="panel dsa5h-body-panel"><div class="panel-title flex"><span>{{localize 'DSA5HELPERS.BodyEquipment'}}</span>{{#if (or prepare.magic.hasSpells prepare.magic.hasPrayers)}}<span class="dsa5h-cast-btns">{{#if prepare.magic.hasSpells}}<button type="button" class="dsa5h-cast-btn" data-action="dsa5hOpenCast" data-kind="spell" aria-haspopup="dialog"><span aria-hidden="true">✦</span>{{localize 'DSA5HELPERS.CastSpells'}}</button>{{/if}}{{#if prepare.magic.hasPrayers}}<button type="button" class="dsa5h-cast-btn" data-action="dsa5hOpenCast" data-kind="liturgy" aria-haspopup="dialog"><span aria-hidden="true">☀</span>{{localize 'DSA5HELPERS.CastLiturgies'}}</button>{{/if}}</span>{{/if}}</div>
<div class="dsa5h-body-grid{{#if dsa5h.body.armorTable}} armor-table{{/if}}"><img class="dsa5h-body-figure" src="{{dsa5h.body.figure}}" alt="" aria-hidden="true">
{{#if dsa5h.editMode}}<div class="dsa5h-body-seg dsa5h-body-figure-switch" role="group" aria-label="{{localize 'DSA5HELPERS.BodyFigure'}}"><button type="button" data-action="dsa5hBodyFigure" data-figure="placeholder" class="{{#unless dsa5h.body.portrait}}active{{/unless}}" aria-pressed="{{#if dsa5h.body.portrait}}false{{else}}true{{/if}}">{{localize 'DSA5HELPERS.BodyFigurePlaceholder'}}</button><button type="button" data-action="dsa5hBodyFigure" data-figure="portrait" class="{{#if dsa5h.body.portrait}}active{{/if}}" aria-pressed="{{#if dsa5h.body.portrait}}true{{else}}false{{/if}}">{{localize 'DSA5HELPERS.BodyFigurePortrait'}}</button></div>{{/if}}
<div class="dsa5h-figure-armor"><small class="dsa5h-figure-col-title">{{localize 'Equipment.armor'}}</small>{{#if dsa5h.body.armorTable}}<table class="dsa5h-body-armor-table"><colgroup><col class="dsa5h-col-img"><col><col class="dsa5h-col-val"><col class="dsa5h-col-val"></colgroup><thead><tr><th colspan="2">{{localize 'Name'}}</th><th title="{{localize 'protection'}}">{{localize 'CHARAbbrev.RS'}}</th><th title="{{localize 'encumbrance'}}">{{localize 'DSA5HELPERS.EncumbranceAbbr'}}</th></tr></thead><tbody>{{#each dsa5h.body.armor as |item|}}<tr class="item" data-item-id="{{item._id}}"><td class="dsa5h-body-armor-img"><img src="{{item.img}}" alt=""></td><td class="dsa5h-body-armor-name withContext" data-tooltip="{{item.name}}"><a data-action="itemEdit">{{item.name}}</a>{{#if item.structureMax}}<meter min="0" max="{{item.structureMax}}" value="{{item.structureCurrent}}"></meter>{{/if}}</td><td>{{item.system.protection.value}}</td><td>{{item.system.calculatedEncumbrance}}</td></tr>{{/each}}</tbody></table>{{else if dsa5h.body.armor.length}}<div class="dsa5h-body-armor">{{#each dsa5h.body.armor as |item|}}<div class="dsa5h-body-armor-item item" data-item-id="{{item._id}}"><span class="dsa5h-body-item-name withContext" data-tooltip="{{item.name}}"><a data-action="itemEdit">{{item.name}}</a></span><div class="dsa5h-armor-slot"><img class="dsa5h-armor-slot-image" src="{{item.img}}" alt="">{{#if item.structureMax}}<meter min="0" max="{{item.structureMax}}" value="{{item.structureCurrent}}"></meter>{{/if}}<span class="dsa5h-armor-slot-rs" title="{{localize 'protection'}}">{{localize 'CHARAbbrev.RS'}} {{item.system.protection.value}}</span><span class="dsa5h-armor-slot-be" title="{{localize 'encumbrance'}}">{{localize 'DSA5HELPERS.EncumbranceAbbr'}} {{item.system.calculatedEncumbrance}}</span></div></div>{{/each}}</div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.NoArmorWorn'}}</p>{{/if}}</div>
<span class="dsa5h-figure-badge"><strong>{{localize 'CHARAbbrev.RS'}} {{prepare.armorSum}}</strong><small>{{localize 'DSA5HELPERS.EncumbranceAbbr'}} {{dsa5h.body.encumbrance}}</small></span>
<div class="dsa5h-figure-hands{{#if dsa5h.body.single}} single{{/if}}">{{#each dsa5h.body.hands as |slot|}}<div class="dsa5h-hand-slot{{#if slot.item}} item combat-weapon{{/if}}"{{#if slot.item}} data-item-id="{{slot.item._id}}"{{/if}}><small class="dsa5h-figure-col-title">{{localize slot.label}}</small>
{{#if slot.item}}<span class="dsa5h-body-item-name withContext"><a data-action="itemEdit">{{slot.item.name}}</a></span><div class="dsa5h-hand-tile"><img src="{{slot.item.img}}" alt="">{{#if slot.item.structureMax}}<meter min="0" max="{{slot.item.structureMax}}" value="{{slot.item.structureCurrent}}"></meter>{{/if}}<span class="dsa5h-die-seal dsa5h-hand-tile-at"><button type="button" class="dsa5h-combat-die dsa5h-die-attack" data-action="chRollCombat" data-mode="attack" title="{{#if slot.ranged}}{{localize 'CHARAbbrev.FK'}}{{else}}{{localize 'CHARAbbrev.AT'}}{{/if}}" aria-label="{{#if slot.ranged}}{{localize 'DSA5HELPERS.RollRangedWith' name=slot.item.name}}{{else}}{{localize 'DSA5HELPERS.RollAttackWith' name=slot.item.name}}{{/if}}">{{slot.item.attack}}</button></span>{{#unless slot.ranged}}<span class="dsa5h-die-seal dsa5h-hand-tile-pa"><button type="button" class="dsa5h-combat-die dsa5h-die-parry" data-action="chRollCombat" data-mode="parry" title="{{localize 'CHARAbbrev.PA'}}" aria-label="{{localize 'DSA5HELPERS.RollParryWith' name=slot.item.name}}">{{slot.item.parry}}</button></span>{{/unless}}</div>
<button type="button" class="dsa5h-damage" data-action="chRollCombat" data-mode="damage" title="{{localize 'CHARAbbrev.damage'}}" aria-label="{{localize 'DSA5HELPERS.RollDamageOf' name=slot.item.name}}">{{slot.item.damagedie}}{{slot.item.damageAdd}}</button>{{else}}<span class="dsa5h-body-item-name">—</span><div class="dsa5h-hand-tile empty"><span>{{localize 'DSA5HELPERS.HandFree'}}</span></div>{{/if}}
<select class="dsa5h-hand-select" data-dsa5h-hand="{{slot.hand}}" data-current="{{slot.item._id}}" aria-label="{{localize 'DSA5HELPERS.WeaponInHand' hand=(localize slot.label)}}"><option value="">{{localize 'DSA5HELPERS.HandFreeOption'}}</option>{{#each slot.options}}<option value="{{id}}"{{#if selected}} selected{{/if}}>{{name}}{{#if twoHanded}} {{localize 'DSA5HELPERS.TwoHandedSuffix'}}{{/if}}</option>{{/each}}</select></div>{{/each}}</div>
</div>
<div class="dsa5h-body-actions">{{> "modules/dsa5-helpers/templates/actors/parts/quick-actions.hbs"}}</div>
<div class="dsa5h-figure-stats"><span><small>{{localize 'initiative'}}</small><strong>{{dsa5h.body.initiative}}</strong></span><span><small>{{localize 'protection'}}</small><strong>{{prepare.armorSum}}</strong></span><span><small>{{localize 'encumbrance'}}</small><strong>{{dsa5h.body.encumbrance}}</strong></span></div>
</section>
{{> "modules/dsa5-helpers/templates/actors/parts/specs.hbs" groups=dsa5h.specs.combat}}
{{#if prepare.magic.hasSpells}}<dialog class="dsa5h-cast-dialog" data-cast-dialog="spell" aria-label="{{localize 'DSA5HELPERS.CastSpellsTitle'}}"><section class="panel"><div class="panel-title flex"><span>{{localize 'DSA5HELPERS.CastSpellsTitle'}}</span><button type="button" data-action="dsa5hCloseCast" aria-label="{{localize 'DSA5HELPERS.Close'}}">✕</button></div>{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="spells" items=prepare.magic.spellList}}{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="rituals" items=prepare.magic.ritualList}}</section>{{> "modules/dsa5-helpers/templates/actors/parts/chips.hbs" title="magictricks" items=prepare.magic.magictrick}}</dialog>{{/if}}
{{#if prepare.magic.hasPrayers}}<dialog class="dsa5h-cast-dialog" data-cast-dialog="liturgy" aria-label="{{localize 'DSA5HELPERS.CastLiturgiesTitle'}}"><section class="panel"><div class="panel-title flex"><span>{{localize 'DSA5HELPERS.CastLiturgiesTitle'}}</span><button type="button" data-action="dsa5hCloseCast" aria-label="{{localize 'DSA5HELPERS.Close'}}">✕</button></div>{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="liturgies" items=prepare.magic.liturgy}}{{> "modules/dsa5-helpers/templates/actors/parts/cast-list.hbs" title="ceremonies" items=prepare.magic.ceremony}}</section>{{> "modules/dsa5-helpers/templates/actors/parts/chips.hbs" title="blessings" items=prepare.magic.blessing}}</dialog>{{/if}}
