<div class="dsa5h-tab" data-tab-panel="combat" hidden><div data-sub-panel="combat:combat">
<div class="dsa5h-quick-actions"><button type="button" data-action="chStatus" data-mod="dodge">{{localize 'dodge'}} {{document.system.status.dodge.max}}</button><button type="button" data-action="chWeaponless" data-char="attack" data-mod="attackWeaponless">{{localize 'attackWeaponless'}} {{prepare.brawling.attack}}</button><button type="button" data-action="chWeaponless" data-char="parry" data-mod="parryWeaponless">{{localize 'parryWeaponless'}} {{prepare.brawling.parry}}</button><button type="button" data-action="chFallingDamage">{{localize 'fallingDamage'}}</button></div>
<div class="grid-2 dsa5h-combat-top"><section class="panel"><div class="panel-title">{{localize 'DSA5HELPERS.CombatValues'}}</div>
{{#each dsa5h.combatValues}}<div class="row dsa5h-pair"><span>{{localize label}}</span><strong>{{value}}</strong></div>{{/each}}</section>
<section class="panel"><div class="panel-title">{{localize 'Equipment.armor'}}</div>
{{#each prepare.wornArmor as |item|}}<div class="row item dsa5h-armor" data-item-id="{{item._id}}"><img src="{{item.img}}" alt=""><div class="dsa5h-armor-body"><span class="withContext"><a data-action="itemEdit">{{item.name}}</a></span><div class="dsa5h-armor-stats"><span class="dsa5h-armor-stat"><strong>{{item.system.protection.value}}</strong><small>{{localize 'protection'}}</small></span><span class="dsa5h-armor-stat"><strong>{{item.system.calculatedEncumbrance}}</strong><small>{{localize 'encumbrance'}}</small></span></div>{{#if item.structureMax}}<meter max="{{item.structureMax}}" value="{{item.structureCurrent}}"></meter>{{/if}}</div></div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}
{{#if prepare.wornArmor.length}}<div class="row dsa5h-pair dsa5h-armor-total"><span>{{localize 'protection'}}</span><strong>{{prepare.armorSum}}</strong></div>{{/if}}
</section></div>
{{#each dsa5h.weaponGroups}}<section class="panel"><div class="panel-title flex"><span>{{localize label}}</span>{{#if @root.owner}}<button type="button" class="unequipped-weapon-menu" data-action="unequippedWeaponMenu" data-weapon-type="{{type}}" aria-label="{{localize 'SHEET.EquipItem'}}">+</button>{{/if}}</div><div class="row-head dsa5h-weapon-row"><span></span><span>{{localize 'Name'}}</span><span>{{localize 'CHARAbbrev.AT'}}</span><span>{{localize 'CHARAbbrev.PA'}}</span><span>{{localize 'CHARAbbrev.damage'}}</span><span>{{localize 'reach'}}</span><span>{{localize 'DSA5HELPERS.Grip'}}</span><span></span><span></span></div>{{#each items as |item|}}{{> "modules/dsa5-helpers/templates/actors/parts/weapon.hbs" item=item ranged=../ranged}}{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}</section>{{/each}}
{{> "modules/dsa5-helpers/templates/actors/parts/specs.hbs" groups=dsa5h.specs.combat}}
</div><div data-sub-panel="combat:skills" hidden><div class="grid-2">{{#each dsa5h.combatSkillGroups as |group|}}<section class="panel"><div class="panel-title">{{localize group.label}}</div><div class="row-head dsa5h-combatskill-row"><span>{{localize 'Name'}}</span><span>{{localize 'guidevalue'}}</span><span>{{localize 'CHARAbbrev.KTW'}}</span><span>{{localize 'CHARAbbrev.AT'}}</span><span>{{localize 'CHARAbbrev.PA'}}</span></div>
{{#each group.items as |item|}}<div class="row item dsa5h-combatskill-row" data-item-id="{{item._id}}"><span class="withContext"><a data-action="itemEdit">{{item.name}}</a></span><span>{{localize (concatUp 'CHARAbbrev.' item.system.guidevalue.value)}}</span>{{> "modules/dsa5-helpers/templates/actors/parts/skill-value.hbs" item=item}}<button type="button" data-action="chRollCombat" data-mode="attack">{{item.system.attack.value}}</button>{{#if (eq item.system.weapontype.value 0)}}<button type="button" data-action="chRollCombat" data-mode="parry">{{item.system.parry.value}}</button>{{else}}<span>–</span>{{/if}}</div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}</section>{{/each}}</div></div></div>