<div class="dsa5h-tab" data-tab-panel="combat" hidden><div data-sub-panel="combat:combat">
{{> "modules/dsa5-helpers/templates/actors/parts/quick-actions.hbs"}}
<div class="grid-2 dsa5h-combat-top"><section class="panel"><div class="panel-title">{{localize 'DSA5HELPERS.CombatValues'}}</div>
{{#each dsa5h.combatValues}}<div class="row dsa5h-pair"><span>{{localize label}}</span><strong>{{value}}</strong></div>{{/each}}</section>
<section class="panel"><div class="panel-title">{{localize 'Equipment.armor'}}</div>
<div class="dsa5h-armor-slots">{{#each prepare.wornArmor as |item|}}<div class="dsa5h-armor-slot item" data-item-id="{{item._id}}"><img class="dsa5h-armor-slot-image" src="{{item.img}}" alt="">{{#if item.structureMax}}<meter min="0" max="{{item.structureMax}}" value="{{item.structureCurrent}}"></meter>{{/if}}<span class="withContext dsa5h-armor-slot-name"><a data-action="itemEdit">{{item.name}}</a></span><span class="dsa5h-armor-slot-rs" title="{{localize 'protection'}}">{{localize 'CHARAbbrev.RS'}} {{item.system.protection.value}}</span><span class="dsa5h-armor-slot-be" title="{{localize 'encumbrance'}}">{{localize 'DSA5HELPERS.EncumbranceAbbr'}} {{item.system.calculatedEncumbrance}}</span></div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}</div>
{{#if prepare.wornArmor.length}}<div class="row dsa5h-pair dsa5h-armor-total"><span>{{localize 'protection'}}</span><strong>{{prepare.armorSum}}</strong></div>{{/if}}
</section></div>
{{#each dsa5h.weaponGroups}}<section class="panel"><div class="panel-title flex"><span>{{localize label}}</span>{{#if @root.owner}}<button type="button" class="unequipped-weapon-menu" data-action="unequippedWeaponMenu" data-weapon-type="{{type}}" aria-label="{{localize 'SHEET.EquipItem'}}">+</button>{{/if}}</div><div class="row-head dsa5h-weapon-row"><span></span><span class="left">{{localize 'Name'}}</span>{{#if ranged}}<span class="dsa5h-span-2">{{localize 'CHARAbbrev.FK'}}</span>{{else}}<span>{{localize 'CHARAbbrev.AT'}}</span><span>{{localize 'CHARAbbrev.PA'}}</span>{{/if}}<span>{{localize 'CHARAbbrev.damage'}}</span><span>{{localize 'reach'}}</span><span>{{localize 'DSA5HELPERS.Grip'}}</span><span></span><span></span></div>{{#each items as |item|}}{{> "modules/dsa5-helpers/templates/actors/parts/weapon.hbs" item=item ranged=../ranged}}{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}</section>{{/each}}
{{> "modules/dsa5-helpers/templates/actors/parts/specs.hbs" groups=dsa5h.specs.combat}}
</div><div data-sub-panel="combat:body" hidden>{{> "modules/dsa5-helpers/templates/actors/parts/body.hbs"}}</div><div data-sub-panel="combat:skills" hidden><div class="dsa5h-search-bar"><input type="search" class="combatSkillSearch" placeholder="{{localize 'DSA5HELPERS.SearchCombatSkills'}}" aria-label="{{localize 'DSA5HELPERS.SearchCombatSkills'}}" /></div><div class="grid-2">{{#each dsa5h.combatSkillGroups as |group|}}<section class="panel"><div class="panel-title">{{localize group.label}}</div><div class="row-head dsa5h-combatskill-row"><span>{{localize 'Name'}}</span><span>{{localize 'guidevalue'}}</span><span>{{localize 'CHARAbbrev.KTW'}}</span><span>{{#if group.ranged}}{{localize 'CHARAbbrev.FK'}}{{else}}{{localize 'CHARAbbrev.AT'}}{{/if}}</span><span>{{#unless group.ranged}}{{localize 'CHARAbbrev.PA'}}{{/unless}}</span></div>
{{#each group.items as |item|}}<div class="row item dsa5h-combatskill-row" data-item-id="{{item._id}}"><span class="withContext"><a data-action="itemEdit">{{item.name}}</a></span><span>{{localize (concatUp 'CHARAbbrev.' item.system.guidevalue.value)}}</span>{{> "modules/dsa5-helpers/templates/actors/parts/skill-value.hbs" item=item}}<button type="button" class="dsa5h-combat-die dsa5h-die-attack" data-action="chRollCombat" data-mode="attack">{{item.system.attack.value}}</button>{{#if (eq item.system.weapontype.value 0)}}<button type="button" class="dsa5h-combat-die dsa5h-die-parry" data-action="chRollCombat" data-mode="parry">{{item.system.parry.value}}</button>{{else}}<span>–</span>{{/if}}</div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}<p class="dsa5h-empty" data-search-empty hidden>{{localize 'DSA5HELPERS.NoSearchResults'}}</p></section>{{/each}}</div></div></div>