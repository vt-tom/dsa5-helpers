<div class="dsa5h-tab" data-tab-panel="combat" hidden>{{!-- „Körper“ ersetzt die frühere Übersicht (Issue #29, 2026-10-02). --}}<div data-sub-panel="combat:body">{{> "modules/dsa5-helpers/templates/actors/parts/body.hbs"}}</div><div data-sub-panel="combat:skills" hidden><div class="dsa5h-search-bar"><input type="search" class="combatSkillSearch" placeholder="{{localize 'DSA5HELPERS.SearchCombatSkills'}}" aria-label="{{localize 'DSA5HELPERS.SearchCombatSkills'}}" /></div><div class="grid-2">{{#each dsa5h.combatSkillGroups as |group|}}<section class="panel"><div class="panel-title">{{localize group.label}}</div><div class="row-head dsa5h-combatskill-row"><span>{{localize 'Name'}}</span><span>{{localize 'CHARAbbrev.KTW'}}</span><span>{{#if group.ranged}}{{localize 'CHARAbbrev.FK'}}{{else}}{{localize 'CHARAbbrev.AT'}}{{/if}}</span><span>{{#unless group.ranged}}{{localize 'CHARAbbrev.PA'}}{{/unless}}</span></div>
{{#each group.items as |item|}}<div class="row item dsa5h-combatskill-row" data-item-id="{{item._id}}"><span class="withContext"><a data-action="itemEdit">{{item.name}}</a><small title="{{localize 'guidevalue'}}">{{localize (concatUp 'CHARAbbrev.' item.system.guidevalue.value)}}</small></span>{{> "modules/dsa5-helpers/templates/actors/parts/skill-value.hbs" item=item}}<button type="button" class="dsa5h-combat-die dsa5h-die-attack" data-action="chRollCombat" data-mode="attack">{{item.system.attack.value}}</button>{{#if (eq item.system.weapontype.value 0)}}<button type="button" class="dsa5h-combat-die dsa5h-die-parry" data-action="chRollCombat" data-mode="parry">{{item.system.parry.value}}</button>{{else}}<span>–</span>{{/if}}</div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}<p class="dsa5h-empty" data-search-empty hidden>{{localize 'DSA5HELPERS.NoSearchResults'}}</p></section>{{/each}}</div></div></div>