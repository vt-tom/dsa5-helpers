<div class="dsa5h-tab" data-tab-panel="cover" hidden><section class="panel"><div class="panel-title">{{localize 'DSA5HELPERS.Favorites'}}</div>{{#each dsa5h.favoriteGroups}}<div class="subhead">{{localize label}}</div><div class="chips">{{#each items as |item|}}<span class="chip item" data-item-id="{{item._id}}"><img src="{{item.img}}" alt=""><span class="withContext"><a data-action="itemEdit">{{item.name}}</a></span>{{#if ../weapon}}<button type="button" data-action="chRollCombat" data-mode="attack">{{localize 'CHARAbbrev.AT'}} {{item.attack}}</button><button type="button" data-action="chRollCombat" data-mode="damage">{{item.damagedie}}{{item.damageAdd}}</button>{{else}}{{> "modules/dsa5-helpers/templates/actors/parts/probe.hbs" item=item}}{{/if}}{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=item}}</span>{{/each}}</div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.NoFavorites'}}</p>{{/each}}</section></div>
