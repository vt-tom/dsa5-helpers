<div class="dsa5h-tab" data-tab-panel="cover" hidden><section class="panel"><div class="panel-title">{{localize 'DSA5HELPERS.Favorites'}}</div>{{#each dsa5h.favoriteGroups}}<div class="subhead">{{localize label}}</div><div class="dsa5h-fav-grid">{{#each items as |item|}}<div class="dsa5h-fav-card item" data-item-id="{{item._id}}"{{#if ../weapon}} data-weapon="true"{{/if}}><img class="dsa5h-fav-icon" src="{{item.img}}" alt=""><button type="button" class="dsa5h-fav-name" data-action="itemEdit" aria-label="{{localize 'DSA5HELPERS.OpenItem' name=item.name}}">{{item.name}}</button>{{> "modules/dsa5-helpers/templates/actors/parts/favorite-values.hbs" item=item weapon=../weapon equipment=../equipment special=../special}}{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=item}}</div>{{/each}}</div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.NoFavorites'}}</p>{{/each}}</section></div>
