<div class="dsa5h-tab" data-tab-panel="cover" hidden><section class="panel"><div class="panel-title">{{localize 'DSA5HELPERS.Favorites'}}</div>{{#each dsa5h.favoriteGroups}}<div class="subhead">{{localize label}}</div><div class="chips">{{#each items as |item|}}<span class="chip item" data-item-id="{{item._id}}"{{#if ../weapon}} data-weapon="true"{{/if}}><img class="dsa5h-fav-icon" src="{{item.img}}" alt=""><span class="dsa5h-fav-name" title="{{item.name}}">{{item.name}}</span>{{> "modules/dsa5-helpers/templates/actors/parts/favorite-values.hbs" item=item weapon=../weapon}}{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=item}}</span>{{/each}}</div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.NoFavorites'}}</p>{{/each}}</section></div>
