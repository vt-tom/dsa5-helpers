{{! Eine Person/ein Wesen als Kachel (Issue #39): immer gleich groß, nur Bild, Name, Untertitel; alles Weitere im Almanach (Klick). Felder aus loadPersonae() in scripts/sheets/almanac.js. }}
<button type="button" class="dsa5h-almanac-tile dsa5h-persona-card" data-action="dsa5hOpenAlmanac" data-almanac-tab="personae" data-page-uuid="{{pageUuid}}" data-entry-key="{{key}}" data-tooltip="{{name}}"><img src="{{img}}" alt=""><span class="dsa5h-tile-text"><strong>{{name}}{{#if important}}<span class="dsa5h-persona-important" data-tooltip="DSA5HELPERS.Personae.Important"> ★</span>{{/if}}{{#if hidden}} <i class="fas fa-eye-slash dsa5h-muted" data-tooltip="DSA5HELPERS.Almanac.Hidden" inert></i>{{/if}}</strong>{{#if subtitle}}<small>{{subtitle}}</small>{{/if}}</span></button>
