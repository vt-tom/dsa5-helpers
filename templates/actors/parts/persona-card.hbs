{{! Eine Person/ein Wesen als Kachel (Issue #39): immer gleich groß, nur Bild, Name, Untertitel; alles Weitere im Almanach (Klick). Felder aus loadPersonae() in scripts/sheets/almanac.js.
   #91: ★ vor dem Namen und „verborgen“ vor dem Untertitel (die Kürzung mit „…“ verschluckt sie sonst), Fraktion als dritte Zeile nur in der ungeteilten Liste; data-persona-* für Suche und Filter. }}
<button type="button" class="dsa5h-almanac-tile dsa5h-persona-card{{#if hidden}} is-hidden{{/if}}" data-action="dsa5hOpenAlmanac" data-almanac-tab="personae" data-page-uuid="{{pageUuid}}" data-entry-key="{{key}}" data-tooltip="{{name}}" data-persona-search="{{name}} {{subtitle}} {{faction}}"{{#if important}} data-persona-important{{/if}}{{#if hidden}} data-persona-hidden{{/if}}><img src="{{img}}" alt=""><span class="dsa5h-tile-text"><strong>{{#if important}}<span class="dsa5h-persona-important" data-tooltip="DSA5HELPERS.Personae.Important">★ </span>{{/if}}{{name}}</strong>{{#if (or subtitle hidden)}}<small>{{#if hidden}}<em class="dsa5h-persona-hidden" data-tooltip="DSA5HELPERS.Almanac.Hidden">{{localize 'DSA5HELPERS.Personae.HiddenMark'}}</em>{{#if subtitle}} · {{/if}}{{/if}}{{subtitle}}</small>{{/if}}<small class="dsa5h-persona-faction">{{faction}}</small></span></button>
