{{!-- Eine Hand im Reiter „Körper“ (body.hbs): side = { slot, twoHanded, moveTo } oder { note } (Issue #29). --}}
{{#if side.note}}<small class="dsa5h-hand-2h-note">{{localize 'DSA5HELPERS.BodyTwoHandedNote'}}</small>{{else}}{{#with side.slot as |slot|}}{{#if (and (eq slot.hand "offhand") (not slot.item))}}<div class="dsa5h-hand-slot dsa5h-hand-free"><div class="dsa5h-hand-tile empty compact" data-tooltip="DSA5HELPERS.HandFreeChoose"><span aria-hidden="true">+</span><select class="dsa5h-hand-select" data-dsa5h-hand="{{slot.hand}}" data-current="" aria-label="{{localize 'DSA5HELPERS.WeaponInHand' hand=(localize slot.label)}}"><option value="">{{localize 'DSA5HELPERS.HandFreeOption'}}</option>{{#each slot.options}}<option value="{{id}}">{{name}}</option>{{/each}}</select></div><span class="dsa5h-hand-free-text"><small class="dsa5h-figure-col-title">{{localize slot.label}}</small><small>{{localize 'DSA5HELPERS.HandFree'}}</small></span></div>{{else}}<div class="dsa5h-hand-slot{{#if slot.item}} item combat-weapon{{/if}}"{{#if slot.item}} data-item-id="{{slot.item._id}}"{{/if}}><small class="dsa5h-figure-col-title">{{#if ../side.twoHanded}}{{localize 'DSA5HELPERS.BothHands'}}{{else}}{{localize slot.label}}{{/if}}</small>
{{#if slot.item}}<span class="dsa5h-body-item-name withContext"><a data-action="itemEdit">{{slot.item.name}}</a></span>{{> "modules/dsa5-helpers/templates/actors/parts/combatskill-link.hbs" item=slot.item}}<div class="dsa5h-hand-tile"><img src="{{slot.item.img}}" alt="">{{#if slot.item.OnUseEffect}}{{> "modules/dsa5-helpers/templates/actors/parts/onuse.hbs" name=slot.item.name}}{{/if}}{{#if slot.item.structureMax}}<meter min="0" max="{{slot.item.structureMax}}" value="{{slot.item.structureCurrent}}"></meter>{{/if}}<span class="dsa5h-die-seal dsa5h-hand-tile-at"><button type="button" class="dsa5h-combat-die dsa5h-die-attack" data-action="chRollCombat" data-mode="attack" title="{{#if slot.ranged}}{{localize 'CHARAbbrev.FK'}}{{else}}{{localize 'CHARAbbrev.AT'}}{{/if}}" aria-label="{{#if slot.ranged}}{{localize 'DSA5HELPERS.RollRangedWith' name=slot.item.name}}{{else}}{{localize 'DSA5HELPERS.RollAttackWith' name=slot.item.name}}{{/if}}">{{slot.item.attack}}</button></span>{{#unless slot.ranged}}<span class="dsa5h-die-seal dsa5h-hand-tile-pa"><button type="button" class="dsa5h-combat-die dsa5h-die-parry" data-action="chRollCombat" data-mode="parry" title="{{localize 'CHARAbbrev.PA'}}" aria-label="{{localize 'DSA5HELPERS.RollParryWith' name=slot.item.name}}">{{slot.item.parry}}</button></span>{{/unless}}</div>
<button type="button" class="dsa5h-damage" data-action="chRollCombat" data-mode="damage" title="{{localize 'CHARAbbrev.damage'}}" aria-label="{{localize 'DSA5HELPERS.RollDamageOf' name=slot.item.name}}">{{slot.item.damagedie}}{{slot.item.damageAdd}}</button>{{#if slot.ranged}}<div class="dsa5h-hand-ranged">{{> "modules/dsa5-helpers/templates/actors/parts/ammo-pick.hbs" item=slot.item}}{{> "modules/dsa5-helpers/templates/actors/parts/ranged-status.hbs" item=slot.item}}</div>{{/if}}{{else}}<span class="dsa5h-body-item-name">—</span><div class="dsa5h-hand-tile empty"><span>{{localize 'DSA5HELPERS.HandFree'}}</span></div>{{/if}}
<select class="dsa5h-hand-select" data-dsa5h-hand="{{slot.hand}}" data-current="{{slot.item._id}}" aria-label="{{localize 'DSA5HELPERS.WeaponInHand' hand=(localize slot.label)}}"><option value="">{{localize 'DSA5HELPERS.HandFreeOption'}}</option>{{#each slot.options}}<option value="{{id}}"{{#if selected}} selected{{/if}}>{{name}}{{#if twoHanded}} {{localize 'DSA5HELPERS.TwoHandedSuffix'}}{{/if}}</option>{{/each}}</select>
{{#if slot.gripSwitch}}<button type="button" class="dsa5h-hand-swap dsa5h-grip-switch" data-action="dsa5hSwapGrip">{{#if (eq slot.gripSwitch 'two')}}{{localize 'DSA5HELPERS.GripSwitchToTwo'}}{{else}}{{localize 'DSA5HELPERS.GripSwitchToOne'}}{{/if}}</button>{{/if}}
{{#if (and ../side.twoHanded @root.dsa5h.editMode)}}<button type="button" class="dsa5h-hand-swap" data-action="dsa5hTwoHandedSide" data-side="{{../side.moveTo}}" aria-label="{{#if (eq ../side.moveTo 'right')}}{{localize 'DSA5HELPERS.BodyMoveRightLabel'}}{{else}}{{localize 'DSA5HELPERS.BodyMoveLeftLabel'}}{{/if}}"><span aria-hidden="true">⇄</span> {{#if (eq ../side.moveTo 'right')}}{{localize 'DSA5HELPERS.BodyMoveRight'}}{{else}}{{localize 'DSA5HELPERS.BodyMoveLeft'}}{{/if}}</button>{{/if}}</div>{{/if}}{{/with}}{{/if}}
