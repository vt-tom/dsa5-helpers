{{!-- Eine Hand im Reiter „Körper“ (body.hbs): side = { slot, twoHanded, moveTo } oder { note } (Issue #29).
     Waffenkarte „Banner“ (Issue #40) mit Wimpel der Hand und der Waffe als Wasserzeichen, seit 2026-10-20 in drei festen
     Bändern (Rückmeldung: Elemente wirkten willkürlich verteilt; Vorlage clickdummy handSlot()): Kopf mit Name, Stern und
     Anwendungswürfel, darunter Kampftechnik · KtW · RW; Mitte Bild | Würfelraster (AT | PA, TP bzw. FK über die volle
     Breite); Fuß mit Aktionen und Fernkampf-Status. Die Handwahl ist das unsichtbare <select> über dem ⇄-Knopf. Freie
     und belegte Hände sind gleich große, gestrichelte Karten (CSS). --}}
{{#if side.note}}<small class="dsa5h-hand-2h-note">{{localize 'DSA5HELPERS.BodyTwoHandedNote'}}</small>{{else}}{{#with side.slot as |slot|}}{{#if (and (eq slot.hand "offhand") (not slot.item))}}<div class="dsa5h-hand-slot dsa5h-hand-free">
  <div class="dsa5h-hand-tile empty compact" data-tooltip="DSA5HELPERS.HandFreeChoose"><span aria-hidden="true">+</span>
    <select class="dsa5h-hand-select" data-dsa5h-hand="{{slot.hand}}" data-current="" aria-label="{{localize 'DSA5HELPERS.WeaponInHand' hand=(localize slot.label)}}"><option value="">{{localize 'DSA5HELPERS.HandFreeOption'}}</option>{{#each slot.options}}<option value="{{id}}">{{name}}{{#if twoHanded}} {{localize 'DSA5HELPERS.TwoHandedSuffix'}}{{/if}}{{#if container}} {{localize 'DSA5HELPERS.InContainerSuffix' name=container}}{{/if}}</option>{{/each}}</select>
  </div>
  <span class="dsa5h-hand-free-text"><small class="dsa5h-figure-col-title">{{localize slot.label}}</small><small>{{localize 'DSA5HELPERS.HandFree'}}</small></span>
</div>{{else if slot.item}}<div class="dsa5h-hand-slot dsa5h-hand-card item combat-weapon{{#if slot.ranged}} ranged{{/if}}" data-item-id="{{slot.item._id}}">
  <img class="dsa5h-hand-bg" src="{{slot.item.img}}" alt="" aria-hidden="true">
  <small class="dsa5h-hand-banner">{{#if ../side.twoHanded}}{{localize 'DSA5HELPERS.BothHands'}}{{else}}{{localize slot.label}}{{/if}}</small>
  <label class="dsa5h-hand-pick" data-tooltip="{{localize 'DSA5HELPERS.WeaponInHand' hand=(localize slot.label)}}"><span aria-hidden="true">⇄</span>
    <select class="dsa5h-hand-select" data-dsa5h-hand="{{slot.hand}}" data-current="{{slot.item._id}}" aria-label="{{localize 'DSA5HELPERS.WeaponInHand' hand=(localize slot.label)}}"><option value="">{{localize 'DSA5HELPERS.HandFreeOption'}}</option>{{#each slot.options}}<option value="{{id}}"{{#if selected}} selected{{/if}}>{{name}}{{#if twoHanded}} {{localize 'DSA5HELPERS.TwoHandedSuffix'}}{{/if}}{{#if container}} {{localize 'DSA5HELPERS.InContainerSuffix' name=container}}{{/if}}</option>{{/each}}</select>
  </label>
  <span class="dsa5h-body-item-name dsa5h-hand-name withContext"><a data-action="itemEdit">{{slot.item.name}}</a>{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=slot.item}}{{#if slot.item.OnUseEffect}}{{> "modules/dsa5-helpers/templates/actors/parts/onuse.hbs" name=slot.item.name}}{{/if}}</span>
  <div class="dsa5h-hand-meta">{{> "modules/dsa5-helpers/templates/actors/parts/combatskill-link.hbs" item=slot.item}}<span class="dsa5h-hand-reach">{{localize 'CHARAbbrev.RW'}} {{#if slot.ranged}}{{slot.item.system.reach.value}}{{else}}{{localize (concat 'Range-' slot.item.system.reach.value)}}{{/if}}</span></div>
  <div class="dsa5h-hand-media">
    <img src="{{slot.item.img}}" alt="">{{#if slot.item.structureMax}}<meter min="0" max="{{slot.item.structureMax}}" value="{{slot.item.structureCurrent}}"></meter>{{/if}}
  </div>
  <div class="dsa5h-hand-stats">
    <button type="button" class="dsa5h-hand-pill" data-action="chRollCombat" data-mode="attack" aria-label="{{#if slot.ranged}}{{localize 'DSA5HELPERS.RollRangedWith' name=slot.item.name}}{{else}}{{localize 'DSA5HELPERS.RollAttackWith' name=slot.item.name}}{{/if}}"><span class="dsa5h-hand-die dsa5h-die-attack">{{slot.item.attack}}</span><b>{{#if slot.ranged}}{{localize 'CHARAbbrev.FK'}}{{else}}{{localize 'CHARAbbrev.AT'}}{{/if}}</b></button>
    {{#unless slot.ranged}}<button type="button" class="dsa5h-hand-pill" data-action="chRollCombat" data-mode="parry" aria-label="{{localize 'DSA5HELPERS.RollParryWith' name=slot.item.name}}"><span class="dsa5h-hand-die dsa5h-die-parry">{{slot.item.parry}}</span><b>{{localize 'CHARAbbrev.PA'}}</b></button>{{/unless}}
    <button type="button" class="dsa5h-damage" data-action="chRollCombat" data-mode="damage" title="{{localize 'CHARAbbrev.damage'}}" aria-label="{{localize 'DSA5HELPERS.RollDamageOf' name=slot.item.name}}"><small>{{localize 'CHARAbbrev.damage'}}</small>{{slot.item.damagedie}}{{slot.item.damageAdd}}</button>
  </div>
  {{#if (or slot.ranged slot.gripSwitch (and ../side.twoHanded @root.dsa5h.editMode))}}<div class="dsa5h-hand-extra">
    {{#if slot.ranged}}<div class="dsa5h-hand-ranged">{{> "modules/dsa5-helpers/templates/actors/parts/ammo-pick.hbs" item=slot.item}}{{> "modules/dsa5-helpers/templates/actors/parts/ranged-status.hbs" item=slot.item}}</div>{{/if}}
    {{#if slot.gripSwitch}}<button type="button" class="dsa5h-hand-swap dsa5h-grip-switch" data-action="dsa5hSwapGrip">{{#if (eq slot.gripSwitch 'two')}}{{localize 'DSA5HELPERS.GripSwitchToTwo'}}{{else}}{{localize 'DSA5HELPERS.GripSwitchToOne'}}{{/if}}</button>{{/if}}
    {{#if (and ../side.twoHanded @root.dsa5h.editMode)}}<button type="button" class="dsa5h-hand-swap" data-action="dsa5hTwoHandedSide" data-side="{{../side.moveTo}}" aria-label="{{#if (eq ../side.moveTo 'right')}}{{localize 'DSA5HELPERS.BodyMoveRightLabel'}}{{else}}{{localize 'DSA5HELPERS.BodyMoveLeftLabel'}}{{/if}}"><span aria-hidden="true">⇄</span> {{#if (eq ../side.moveTo 'right')}}{{localize 'DSA5HELPERS.BodyMoveRight'}}{{else}}{{localize 'DSA5HELPERS.BodyMoveLeft'}}{{/if}}</button>{{/if}}
  </div>{{/if}}
</div>{{else}}<div class="dsa5h-hand-slot dsa5h-hand-empty">
  <small class="dsa5h-figure-col-title">{{localize slot.label}}</small>
  <small class="dsa5h-hand-empty-text">{{localize 'DSA5HELPERS.HandFree'}}</small>
  <select class="dsa5h-hand-select" data-dsa5h-hand="{{slot.hand}}" data-current="" aria-label="{{localize 'DSA5HELPERS.WeaponInHand' hand=(localize slot.label)}}"><option value="">{{localize 'DSA5HELPERS.HandFreeOption'}}</option>{{#each slot.options}}<option value="{{id}}">{{name}}{{#if twoHanded}} {{localize 'DSA5HELPERS.TwoHandedSuffix'}}{{/if}}{{#if container}} {{localize 'DSA5HELPERS.InContainerSuffix' name=container}}{{/if}}</option>{{/each}}</select>
</div>{{/if}}{{/with}}{{/if}}
