{{! Reiter „Personen“ (Issue #39): Dramatis Personae und Bestiarium aus dem Almanach des Systems (scripts/sheets/almanac.js), Unterreiter als Sprungmarken.
   Seit #91 (2026-11-16) mit Werkzeugleiste: Suche, Filter Alle/Wichtige/Verborgene (nur SL), Gruppen nach Fraktion, Ansicht Kacheln/Liste.
   Suche, Filter und Ansicht wendet _applyPersonae() ohne Neuzeichnen an, „Nach Fraktion“ zeichnet neu. }}
<div class="dsa5h-tab" data-tab-panel="personae" data-persona-view="tiles" hidden>
<div class="dsa5h-almanac-bar"><small class="dsa5h-muted">{{localize 'DSA5HELPERS.Almanac.PersonaeIntro'}}</small><button type="button" class="dsa5h-almanac-btn" data-action="dsa5hOpenAlmanac" data-almanac-tab="personae"><i class="fas fa-book-open" inert></i> {{localize 'DSA5HELPERS.Almanac.Open'}}</button></div>
<div class="dsa5h-search-bar dsa5h-personae-tools">
<input type="search" class="personaeSearch" placeholder="{{localize 'DSA5HELPERS.Personae.Search'}}" aria-label="{{localize 'DSA5HELPERS.Personae.Search'}}" />
<div class="dsa5h-seg" role="group" aria-label="{{localize 'DSA5HELPERS.Personae.Filter'}}"><button type="button" data-action="dsa5hPersonaeFilter" data-persona-filter="all" aria-pressed="true">{{localize 'DSA5HELPERS.Personae.All'}}</button><button type="button" data-action="dsa5hPersonaeFilter" data-persona-filter="important" aria-pressed="false">★ {{localize 'DSA5HELPERS.Personae.ImportantOnly'}}</button>{{#if dsa5h.personae.canSeeHidden}}<button type="button" data-action="dsa5hPersonaeFilter" data-persona-filter="hidden" aria-pressed="false">{{localize 'DSA5HELPERS.Personae.HiddenOnly'}}</button>{{/if}}</div>
<button type="button" class="dsa5h-filter-switch{{#if dsa5h.personae.byFaction}} on{{/if}}" data-action="dsa5hPersonaeFaction" role="switch" aria-checked="{{#if dsa5h.personae.byFaction}}true{{else}}false{{/if}}"><span class="dsa5h-filter-switch-track" aria-hidden="true"><span class="dsa5h-filter-switch-thumb"></span></span>{{localize 'DSA5HELPERS.Personae.ByFaction'}}</button>
<div class="dsa5h-seg dsa5h-persona-views" role="group" aria-label="{{localize 'DSA5HELPERS.Personae.View'}}"><button type="button" data-action="dsa5hPersonaeView" data-persona-view-choice="tiles" aria-pressed="true">{{localize 'DSA5HELPERS.Personae.Tiles'}}</button><button type="button" data-action="dsa5hPersonaeView" data-persona-view-choice="list" aria-pressed="false">{{localize 'DSA5HELPERS.Personae.List'}}</button></div>
</div>
{{#each dsa5h.personae.sections as |sec|}}<div data-sub-panel="personae:{{sec.id}}"><section class="panel" data-persona-section><div class="panel-title flex"><span>{{localize sec.label}}</span><small class="dsa5h-panel-count" data-persona-count></small></div>
{{#each sec.groups as |group|}}<div class="dsa5h-persona-group" data-persona-group>{{#if @root.dsa5h.personae.byFaction}}<div class="dsa5h-persona-group-title">{{#if group.noFaction}}{{localize 'DSA5HELPERS.Personae.NoFaction'}}{{else}}{{group.label}}{{/if}} <span class="dsa5h-muted" data-group-count>({{group.items.length}})</span></div>{{/if}}<div class="dsa5h-tile-grid dsa5h-persona-items">{{#each group.items}}{{> "modules/dsa5-helpers/templates/actors/parts/persona-card.hbs"}}{{/each}}</div></div>{{/each}}
<p class="dsa5h-empty" data-persona-empty{{#if sec.total}} hidden{{/if}}>{{localize 'DSA5HELPERS.Personae.Empty'}}</p><p class="dsa5h-empty" data-persona-nomatch hidden></p></section></div>{{/each}}
</div>
