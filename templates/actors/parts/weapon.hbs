<div class="row dsa5h-weapon-row item combat-weapon" data-item-id="{{item._id}}" data-subweapon="{{subweapon}}">
<span class="dsa5h-item-image {{item.system.damageToolTip.css}}" data-tooltip="{{item.system.damageToolTip.msg}}"><img src="{{item.img}}" alt="">{{#if item.structureMax}}<meter min="0" max="{{item.structureMax}}" value="{{item.structureCurrent}}"></meter>{{/if}}</span>
<span class="withContext"><a data-action="itemEdit">{{item.name}}</a><small>{{localize item.system.combatskill.value}}</small></span>
<span class="dsa5h-weapon-attack{{#if ranged}} dsa5h-span-2{{/if}}"><button type="button" class="dsa5h-combat-die dsa5h-die-attack" data-action="chRollCombat" data-mode="attack" title="{{#if ranged}}{{localize 'CHARAbbrev.FK'}}{{else}}{{localize 'CHARAbbrev.AT'}}{{/if}}" aria-label="{{#if ranged}}{{localize 'DSA5HELPERS.RollRangedWith' name=item.name}}{{else}}{{localize 'DSA5HELPERS.RollAttackWith' name=item.name}}{{/if}}">{{item.attack}}</button>
</span>{{#unless ranged}}<button type="button" class="dsa5h-combat-die dsa5h-die-parry" data-action="chRollCombat" data-mode="parry" title="{{localize 'CHARAbbrev.PA'}}" aria-label="{{localize 'DSA5HELPERS.RollParryWith' name=item.name}}">{{item.parry}}</button>{{/unless}}
<button type="button" class="dsa5h-damage" data-action="chRollCombat" data-mode="damage" title="{{localize 'CHARAbbrev.damage'}}" aria-label="{{localize 'DSA5HELPERS.RollDamageOf' name=item.name}}">{{item.damagedie}}{{item.damageAdd}}</button>
<span class="center">{{#if ranged}}{{item.system.reach.value}}{{else}}{{localize (concat 'Range-' item.system.reach.value)}}{{/if}}</span>
<span class="dsa5h-grip">{{#if item.wieldedTwoHand}}<button type="button" class="dsa5h-grip-btn active" data-action="swapWeaponHand" data-tooltip="wrongGrip.twoHanded">{{localize 'DSA5HELPERS.GripBoth'}}</button>{{else}}<button type="button" class="dsa5h-grip-btn {{#unless item.system.worn.offHand}}active{{/unless}}" data-action="swapWeaponHandSlot" data-hand="main" data-tooltip="mainHand" aria-label="{{localize 'mainHand'}}: {{item.name}}" aria-pressed="{{#if item.system.worn.offHand}}false{{else}}true{{/if}}">{{localize 'DSA5HELPERS.GripMain'}}</button><button type="button" class="dsa5h-grip-btn {{#if item.system.worn.offHand}}active{{/if}}" data-action="swapWeaponHandSlot" data-hand="offhand" data-tooltip="offHand" aria-label="{{localize 'offHand'}}: {{item.name}}" aria-pressed="{{#if item.system.worn.offHand}}true{{else}}false{{/if}}">{{localize 'DSA5HELPERS.GripOff'}}</button>{{/if}}</span>
<button type="button" data-action="weaponContextMenu" aria-label="{{localize 'SHEET.EditItem'}}">⋮</button>{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=item}}
{{#if ranged}}<div class="dsa5h-weapon-details">{{#if item.ammo}}<span>{{localize 'TYPES.Item.ammunition'}}</span><details class="dsa5h-ammo-pick"><summary aria-label="{{localize 'VEHICLE.pickAmmo'}}: {{item.name}}">{{#if item.selectedAmmo.img}}{{item.selectedAmmo.tooltip}} <small>×{{item.selectedAmmo.count}}</small>{{else}}{{localize 'VEHICLE.clearAmmo'}}{{/if}}</summary><div class="dsa5h-ammo-menu">{{#each item.ammo}}<button type="button" class="dsa5h-ammo-chip" data-action="selectAmmo" data-ammo-id="{{pickId}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{name}}{{#if count}} ×{{count}}{{/if}}</button>{{/each}}<button type="button" class="dsa5h-ammo-chip" data-action="selectAmmo" data-ammo-id="clear" aria-pressed="{{#if item.clearAmmo.selected}}true{{else}}false{{/if}}">{{localize 'VEHICLE.clearAmmo'}}</button></div></details>{{/if}}
{{#if (gt item.LZ 0)}}<span class="dsa5h-reload{{#if (gte item.system.reloadTime.progress item.LZ)}} dsa5h-reload-done{{/if}}"><button type="button" class="dsa5h-reload-btn" data-action="loadWeapon" data-tooltip="{{item.title}}" aria-label="{{localize 'WEAPON.reload'}}: {{item.name}} ({{item.title}})"><span>{{#if (gte item.system.reloadTime.progress item.LZ)}}{{localize 'WEAPON.loaded'}}{{else}}{{localize 'WEAPON.reload'}}{{/if}}</span><span class="dsa5h-reload-bar" style="--lz:{{item.LZ}}" aria-hidden="true"><span style="width:{{dsa5hPercent item.system.reloadTime.progress item.LZ}}%"></span></span><span class="dsa5h-reload-count">{{item.progress}}</span></button>{{#if (gt item.system.reloadTime.progress 0)}}<button type="button" class="dsa5h-reload-reset" data-action="dsa5hReloadReset" data-tooltip="DSA5HELPERS.ReloadReset" aria-label="{{localize 'DSA5HELPERS.ReloadReset'}}: {{item.name}}">↺</button>{{/if}}</span>{{/if}}{{#if item.ammoMax}}<span class="dsa5h-mag"><span class="dsa5h-mag-label">{{localize 'DSA5HELPERS.Magazine'}}</span><strong>{{item.ammoCurrent}}/{{item.ammoMax}}</strong><button type="button" class="dsa5h-mag-swap" data-action="itemSwapMag" data-tooltip="SHEET.swapMag" aria-label="{{localize 'SHEET.swapMag'}}: {{item.name}}"{{#if (gte item.ammoCurrent item.ammoMax)}} aria-disabled="true"{{/if}}>⇄</button></span>{{/if}}</div>{{/if}}</div>
{{#each item.subweapons as |sub key|}}{{> "modules/dsa5-helpers/templates/actors/parts/weapon.hbs" item=sub subweapon=key ranged=../ranged}}{{/each}}