      <div class="dsa5h-tab" data-tab-panel="skills" hidden>
        <div class="dsa5h-search-bar">
          <input type="search" class="talentSearch" placeholder="{{localize 'searchTalents'}}" aria-label="{{localize 'searchTalents'}}" />
          <button type="button" class="dsa5h-filter-switch" data-action="dsa5hOnlyLearned" role="switch" aria-checked="false"><span class="dsa5h-filter-switch-track" aria-hidden="true"><span class="dsa5h-filter-switch-thumb"></span></span>{{localize 'DSA5HELPERS.OnlyLearned'}}</button>
        </div>
        <div class="dsa5h-search-info" data-talent-search-info role="status" hidden><span data-talent-search-text></span><button type="button" data-action="dsa5hClearTalentSearch">{{localize 'DSA5HELPERS.ClearSearch'}}</button></div>
        <div class="allTalents showAll">
          {{#each dsa5h.skillGroups as |group|}}
          <section class="panel dsa5h-skill-panel" data-skill-panel="{{group.id}}" hidden>
            <div class="panel-title">{{localize (concat "SKILL." group.id)}}</div>
            <div class="row-head dsa5h-skill-row"><span></span><span class="left">{{localize "TYPES.Item.skill"}}</span><span>{{localize "probe"}}</span><span>{{localize "encumbrance"}}</span><span>{{localize "CHARAbbrev.FW"}}</span><span></span></div>
            {{#each group.items as |item|}}
            <div class="row dsa5h-skill-row item" data-item-id="{{item._id}}" data-fw="{{item.system.talentValue.value}}">
              <img src="{{item.img}}" alt="" />
              <span class="withContext"><a class="talentName" data-action="itemEdit">{{item.name}}</a>{{#if (eq item._id @root.dsa5h.woundCheckSkill)}}<button type="button" class="dsa5h-house-hint" data-action="dsa5hWoundCheck" data-tooltip="DSA5HELPERS.HouseRules.woundCheck.HintTooltip"><i class="fas fa-heart-pulse" inert></i> {{localize "DSA5HELPERS.HouseRules.woundCheck.Title"}}</button>{{/if}}</span>
              {{> "modules/dsa5-helpers/templates/actors/parts/probe.hbs" item=item}}
              <span class="center">{{localize item.system.burden.value}}</span>
              {{> "modules/dsa5-helpers/templates/actors/parts/skill-value.hbs" item=item}}
              {{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=item}}
            </div>
            {{else}}<p class="muted">{{localize "DSA5HELPERS.NoSkills"}}</p>{{/each}}
            <p class="muted" data-only-learned-empty hidden>{{localize "DSA5HELPERS.NoLearnedSkills"}}</p>
          </section>
          {{/each}}
        </div>
        <section class="panel" data-skill-panel="aggregated" hidden>
          <div class="panel-title flex"><span>{{localize "aggregatedTests"}}</span>{{#if @root.editable}}<button type="button" data-action="itemCreate" data-type="aggregatedTest" item-section="aggregatedTest" aria-label="{{localize 'SHEET.addItem'}}">+</button>{{/if}}</div>
          {{#each dsa5h.aggregated as |agg|}}
          <div class="item dsa5h-aggregated" data-item-id="{{agg.item._id}}">
            <div class="row dsa5h-aggregated-head"><span class="withContext"><a data-action="itemEdit">{{agg.item.name}}</a></span><span>{{localize "interval"}}: {{agg.item.system.interval.value}}</span><span>{{localize "probes"}}: {{agg.item.system.usedTestCount.value}} / {{agg.item.system.allowedTestCount.value}}</span><span>{{localize "CHARAbbrev.QS"}}: {{agg.item.system.cummulatedQS.value}} / 10</span></div>
            {{#each agg.talents as |talent|}}
            <div class="row dsa5h-aggregated-talent">{{#if talent.skill}}<img src="{{talent.skill.img}}" alt="" /><span>{{talent.name}}</span>{{> "modules/dsa5-helpers/templates/actors/parts/probe.hbs" item=talent.skill action="rollAggregatedProbe" which=talent.which}}<strong class="dsa5h-aggregated-fw" title="{{localize 'Fw'}}">{{talent.skill.system.talentValue.value}}</strong>{{else}}<span></span><span>{{talent.name}}</span><button type="button" class="dsa5h-aggregated-roll" data-action="rollAggregatedProbe" data-which="{{talent.which}}" aria-label="{{localize 'DSA5HELPERS.RollNamed' name=talent.name}}">{{localize 'probe'}}</button><span></span>{{/if}}</div>
            {{/each}}
          </div>
          {{else}}<p class="muted">{{localize "DSA5HELPERS.NoAggregatedTests"}}</p>{{/each}}
        </section>
      </div>
