{{!-- Titelblatt des NSC (Issue #53, Click-Dummy actor-types.js renderTypeCover): Angriffe nur ausgerüsteter Waffen,
      Talente mit Wert – Sinnesschärfe und Willenskraft immer oben, die übrigen in wählbarer Anzahl (− / +, je Benutzer) –,
      darunter die Favoriten wie beim Helden. Favorisierte Talente stehen nur bei den Favoriten. --}}
<div class="dsa5h-tab" data-tab-panel="cover" hidden>
<section class="panel dsa5h-short-weapons-panel"><div class="panel-title">{{localize 'DSA5HELPERS.Creature.Attacks'}}</div>{{#if dsa5h.npc.attacks.length}}<div class="dsa5h-short-weapons">{{#each dsa5h.npc.attacks}}{{> "modules/dsa5-helpers/templates/actors/parts/weapon-short.hbs" item=item ranged=ranged}}{{/each}}</div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Npc.NoWeapon'}}</p>{{/if}}</section>
<section class="panel"><div class="panel-title dsa5h-suggest-head"><span class="dsa5h-suggest-title">{{localize 'skills'}}</span><span class="dsa5h-suggest-count" role="group" aria-label="{{localize 'DSA5HELPERS.Npc.TalentCount'}}"><button type="button" data-action="dsa5hNpcTalentCount" data-step="-2" aria-label="{{localize 'DSA5HELPERS.Npc.TalentsFewer'}}" data-tooltip="DSA5HELPERS.Npc.TalentsFewer"{{#unless dsa5h.npc.talentsFewer}} disabled{{/unless}}>−</button><span>{{dsa5h.npc.talentCount}}</span><button type="button" data-action="dsa5hNpcTalentCount" data-step="2" aria-label="{{localize 'DSA5HELPERS.Npc.TalentsMore'}}" data-tooltip="DSA5HELPERS.Npc.TalentsMore"{{#unless dsa5h.npc.talentsMore}} disabled{{/unless}}>+</button></span></div><div class="dsa5h-fav-grid">{{#each dsa5h.npc.fixedTalents as |item|}}{{> "modules/dsa5-helpers/templates/actors/parts/creature-card.hbs" item=item}}{{/each}}{{#each dsa5h.npc.talents as |item|}}<div class="dsa5h-fav-card item" data-item-id="{{item._id}}"><img class="dsa5h-fav-icon" src="{{item.img}}" alt=""><span class="dsa5h-fav-name-cell"><button type="button" class="dsa5h-fav-name" data-action="itemEdit" aria-label="{{localize 'DSA5HELPERS.OpenItem' name=item.name}}">{{item.name}}</button></span>{{> "modules/dsa5-helpers/templates/actors/parts/favorite-values.hbs" item=item}}{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=item}}</div>{{/each}}</div></section>
<section class="panel"><div class="panel-title">{{localize 'DSA5HELPERS.Favorites'}}</div>{{#each dsa5h.favoriteGroups}}<div class="subhead">{{localize label}}</div><div class="dsa5h-fav-grid">{{#each items as |item|}}<div class="dsa5h-fav-card item" data-item-id="{{item._id}}"{{#if ../weapon}} data-weapon="true"{{/if}}><img class="dsa5h-fav-icon" src="{{item.img}}" alt=""><span class="dsa5h-fav-name-cell"><button type="button" class="dsa5h-fav-name" data-action="itemEdit" aria-label="{{localize 'DSA5HELPERS.OpenItem' name=item.name}}">{{item.name}}</button></span>{{> "modules/dsa5-helpers/templates/actors/parts/favorite-values.hbs" item=item weapon=../weapon equipment=../equipment special=../special}}{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=item}}</div>{{/each}}</div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.NoFavorites'}}</p>{{/each}}</section>
</div>
