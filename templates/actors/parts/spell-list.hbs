<section class="panel"><div class="panel-title flex"><span>{{localize title}}</span>{{#if @root.dsa5h.editMode}}<button type="button" data-action="itemCreate" data-type="{{type}}" item-section="{{type}}" {{#if kind}}data-magical-action-kind="{{kind}}"{{/if}} aria-label="{{localize 'SHEET.addItem'}}">+</button>{{/if}}</div>
<div class="row-head dsa5h-spell-row"><span></span><span class="left">{{localize 'Name'}}</span><span>{{localize 'probe'}}</span><span>{{localize 'CHARAbbrev.FW'}}</span><span>{{localize 'cost'}}</span><span>{{localize 'castingTime'}}</span><span>{{localize 'reach'}}</span><span></span></div>
{{#each items as |item|}}<div class="row dsa5h-spell-row item" data-item-id="{{item._id}}"><span class="dsa5h-item-image"><img src="{{item.img}}" alt="">{{#if item.extensions}}<span class="dsa5h-extensions" data-tooltip="{{item.extensions}}">↑</span>{{/if}}</span><span class="withContext"><a data-action="itemEdit">{{item.name}}</a></span>
{{> "modules/dsa5-helpers/templates/actors/parts/probe.hbs" item=item}}{{> "modules/dsa5-helpers/templates/actors/parts/skill-value.hbs" item=item}}
<span>{{item.system.AsPCost.value}}</span><span>{{item.system.castingTime.value}}{{#if (gt item.LZ 1)}}<button type="button" data-action="chargeSpell" title="{{item.title}}">{{item.progress}} / {{item.LZ}}</button>{{/if}}</span><span>{{item.system.range.value}}</span>{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=item}}</div>
{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}</section>