<section class="panel"><div class="panel-title flex"><span>{{localize title}}</span>{{#if @root.dsa5h.advanceMode}}<button type="button" data-action="itemCreate" data-type="{{type}}" item-section="{{type}}" {{#if kind}}data-magical-action-kind="{{kind}}"{{/if}} aria-label="{{localize 'SHEET.addItem'}}">+</button>{{/if}}</div>
<div class="row-head dsa5h-spell-row"><span></span><span class="left">{{localize 'Name'}}</span><span>{{localize 'probe'}}</span><span>{{localize 'CHARAbbrev.FW'}}</span><span>{{localize 'cost'}}</span><span>{{localize 'castingTime'}}</span><span>{{localize 'reach'}}</span><span></span></div>
{{#each items as |item|}}<div class="row dsa5h-spell-row item" data-item-id="{{item._id}}"><span class="dsa5h-item-image"><img src="{{item.img}}" alt=""></span><span class="withContext dsa5h-magic-name"><a data-action="itemEdit">{{item.name}}</a>{{#with (lookup @root.dsa5h.spellExtensions item._id) as |exts|}}<button type="button" class="dsa5h-ext-toggle" data-action="dsa5hToggleExtensions" data-ext-for="{{item._id}}" aria-expanded="false" aria-label="{{localize 'DSA5HELPERS.ExtensionToggle' count=exts.length}}" data-tooltip="{{localize 'DSA5HELPERS.ExtensionToggle' count=exts.length}}"><span class="dsa5h-ext-star" aria-hidden="true">✦</span>{{exts.length}}<span class="dsa5h-ext-sign" aria-hidden="true">+</span></button>{{/with}}</span>
{{> "modules/dsa5-helpers/templates/actors/parts/probe.hbs" item=item}}{{> "modules/dsa5-helpers/templates/actors/parts/skill-value.hbs" item=item}}
<span data-dsa5h-unit="{{#if (or (eq ../type 'liturgy') (eq ../type 'ceremony'))}}{{localize 'CHARAbbrev.KaP'}}{{else}}{{localize 'CHARAbbrev.AsP'}}{{/if}}">{{item.system.AsPCost.value}}</span><span data-dsa5h-label="{{localize 'DSA5HELPERS.Mobile.CastShort'}}">{{item.system.castingTime.value}}{{#if (gt item.LZ 1)}}<button type="button" data-action="chargeSpell" title="{{item.title}}">{{item.progress}} / {{item.LZ}}</button>{{/if}}</span><span>{{item.system.range.value}}</span>{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=item}}</div>
{{#with (lookup @root.dsa5h.spellExtensions item._id) as |exts|}}<div class="dsa5h-ext-list" data-ext-list="{{item._id}}" hidden>{{#each exts as |ext|}}<div class="dsa5h-ext-item item" data-item-id="{{ext.id}}"><span class="dsa5h-ext-star" aria-hidden="true">✦</span><a class="dsa5h-ext-name" data-action="itemEdit">{{ext.name}}</a><div class="dsa5h-ext-desc">{{{ext.description}}}</div></div>{{/each}}</div>{{/with}}
{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}<div class="dsa5h-table-legend"><span class="dsa5h-extensions-inline" aria-hidden="true">✦</span>{{localize 'DSA5HELPERS.ExtensionLegend'}}</div></section>