{{!-- Notizen der Kreatur wie im Systembogen (creature-notes.hbs): Beschreibung, Verhalten, Flucht, Sonderregeln, Notizen,
      private Notizen – je Unterreiter ein Panel mit Sprungmarke wie beim Helden. --}}
<div class="dsa5h-tab" data-tab-panel="notes" hidden><div class="dsa5h-notes-text">
<div data-sub-panel="notes:description"><section class="panel"><div class="panel-title">{{localize 'Description'}}</div><div class="dsa5h-panel-note">👁 {{localize 'DSA5HELPERS.VisibleAll'}}</div><div class="dsa5h-richtext">{{formInput systemFields.description.fields.value value=document.system.description.value toggled=true enriched=enrichedDescription disabled=(not editable)}}</div></section></div>
<div data-sub-panel="notes:behaviour"><section class="panel"><div class="panel-title">{{localize 'behaviour'}}</div><div class="dsa5h-panel-note">👁 {{localize 'DSA5HELPERS.VisibleAll'}}</div><div class="dsa5h-richtext">{{formInput systemFields.behaviour.fields.value value=document.system.behaviour.value toggled=true enriched=enrichedBehaviour disabled=(not editable)}}</div></section></div>
<div data-sub-panel="notes:flight"><section class="panel"><div class="panel-title">{{localize 'flight'}}</div><div class="dsa5h-panel-note">👁 {{localize 'DSA5HELPERS.VisibleAll'}}</div><div class="dsa5h-richtext">{{formInput systemFields.flight.fields.value value=document.system.flight.value toggled=true enriched=enrichedFlight disabled=(not editable)}}</div></section></div>
<div data-sub-panel="notes:specialRules"><section class="panel"><div class="panel-title">{{localize 'specialRules'}}</div><div class="dsa5h-panel-note">👁 {{localize 'DSA5HELPERS.VisibleAll'}}</div><div class="dsa5h-richtext">{{formInput systemFields.specialRules.fields.value value=document.system.specialRules.value toggled=true enriched=enrichedSpecialrules disabled=(not editable)}}</div></section></div>
<div data-sub-panel="notes:notes"><section class="panel"><div class="panel-title">{{localize 'Notes'}}</div><div class="dsa5h-panel-note">👁 {{localize 'DSA5HELPERS.VisibleAll'}}</div><div class="dsa5h-richtext">{{formInput systemFields.details.fields.notes.fields.value value=document.system.details.notes.value toggled=true enriched=enrichedNotes disabled=(not editable)}}</div></section></div>
{{#if owner}}<div data-sub-panel="notes:ownernotes"><section class="panel"><div class="panel-title">{{localize 'ownerNotes'}}</div><div class="dsa5h-panel-note">👁 {{localize 'DSA5HELPERS.VisibleOwner'}}</div><div class="dsa5h-richtext">{{formInput systemFields.details.fields.notes.fields.ownerdescription value=document.system.details.notes.ownerdescription toggled=true enriched=enrichedOwnerdescription disabled=(not editable)}}</div></section></div>{{/if}}
</div></div>
