{{!-- Munitionswahl einer Fernkampfwaffe (Systemaktion selectAmmo, inkl. „Keine Munition“), in der Fernkampfhand des
     Körper-Reiters (seit die Waffentabellen entfallen sind, Issue #29). Schließt sich bei Klick daneben (_onRender). --}}
{{#if @root.dsa5h.legacySystem}}
{{#if item.ammo}}<select class="ammo-selector" data-item-id="{{item._id}}" aria-label="{{localize 'DSA5HELPERS.SelectAmmo'}}: {{item.name}}">{{selectOptions item.ammo selected=item.system.currentAmmo.value blank="-" valueAttr="_id" labelAttr="label"}}</select>{{/if}}
{{else}}
{{#if item.ammo}}<details class="dsa5h-ammo-pick"><summary aria-label="{{localize 'VEHICLE.pickAmmo'}}: {{item.name}}">{{#if item.selectedAmmo.img}}{{item.selectedAmmo.tooltip}} <small>×{{item.selectedAmmo.count}}</small>{{else}}{{localize 'VEHICLE.clearAmmo'}}{{/if}}</summary><div class="dsa5h-ammo-menu">{{#each item.ammo}}<button type="button" class="dsa5h-ammo-chip" data-action="selectAmmo" data-ammo-id="{{pickId}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">{{name}}{{#if count}} ×{{count}}{{/if}}</button>{{/each}}<button type="button" class="dsa5h-ammo-chip" data-action="selectAmmo" data-ammo-id="clear" aria-pressed="{{#if item.clearAmmo.selected}}true{{else}}false{{/if}}">{{localize 'VEHICLE.clearAmmo'}}</button></div></details>{{/if}}
{{/if}}
