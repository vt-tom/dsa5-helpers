<aside class="dsa5h-cover-sidebar" data-cover-sidebar>
  <div data-cover-slot="portrait"></div>
  <div class="dsa5h-cover-resources" data-cover-slot="resources"></div>
  <div class="dsa5h-cover-fate" data-cover-slot="fate"></div>
  {{#if conditions.length}}
  <section class="panel">
    <div class="panel-title">{{localize 'statuseffects'}}</div>
    {{#each dsa5h.coverConditions}}
    <div class="row dsa5h-cover-condition" data-id="{{_id}}" {{#if descriptor}}data-descriptor="{{descriptor}}"{{/if}}>
      <img src="{{img}}" alt="" />
      <a data-action="conditionShow" data-id="{{_id}}">{{localize name}}</a>
      <span class="dsa5h-cond-steps">{{#if editable}}{{#unless boolean}}<button type="button" class="dsa5h-step" data-action="dsa5hConditionDown" aria-label="{{localize 'DSA5HELPERS.ConditionDecrease' name=(localize name)}}"{{#unless manual}} aria-disabled="true"{{/unless}}>−</button><button type="button" class="dsa5h-step" data-action="conditionValue" aria-label="{{localize 'DSA5HELPERS.ConditionIncrease' name=(localize name)}}"{{#if (gte value editable)}} aria-disabled="true"{{/if}}>+</button>{{/unless}}{{/if}}</span><strong{{#if editable}}{{#unless boolean}} aria-label="{{localize 'DSA5HELPERS.ConditionLevel' value=value max=editable}}"{{/unless}}{{/if}}>{{value}}{{#if editable}}{{#unless boolean}}<small>/{{editable}}</small>{{/unless}}{{/if}}</strong>
    </div>
    {{/each}}
    {{#if dsa5h.coverConditionsMore}}
    <button type="button" class="dsa5h-cover-more" data-action="dsa5hSetTab" data-tab="status">+{{dsa5h.coverConditionsMore}} {{localize 'DSA5HELPERS.More'}} → {{localize 'DSA5HELPERS.Tabs.status'}}</button>
    {{/if}}
  </section>
  {{/if}}
</aside>
