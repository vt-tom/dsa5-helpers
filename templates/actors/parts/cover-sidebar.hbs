<aside class="dsa5h-cover-sidebar" data-cover-sidebar>
  <div data-cover-slot="portrait"></div>
  <div class="dsa5h-cover-resources" data-cover-slot="resources"></div>
  <div class="dsa5h-cover-fate" data-cover-slot="fate"></div>
  {{#if conditions.length}}
  <section class="panel">
    <div class="panel-title">{{localize 'statuseffects'}}</div>
    {{#each dsa5h.coverConditions}}
    <div class="row dsa5h-cover-condition">
      <img src="{{img}}" alt="" />
      <a data-action="conditionShow" data-id="{{_id}}">{{localize name}}</a>
      <strong>{{value}}</strong>
    </div>
    {{/each}}
    {{#if dsa5h.coverConditionsMore}}
    <button type="button" class="dsa5h-cover-more" data-action="dsa5hSetTab" data-tab="status">+{{dsa5h.coverConditionsMore}} {{localize 'DSA5HELPERS.More'}} → {{localize 'DSA5HELPERS.Tabs.status'}}</button>
    {{/if}}
  </section>
  {{/if}}
</aside>
