{{!-- Kurzübersicht „Weitere Waffen“ im Körper-Reiter (Issue #29, Rückmeldung 2026-10-02): alle Waffen, die gerade
     nicht in einer Hand sind, und Angriffe aus Eigenschaften. Würfel bleiben, damit z. B. ein Biss würfelbar ist. Echte Waffen
     haben den Ausrüsten-Knopf aus dem Inventar (Klick: in die Hand, Rechtsklick: Hand wählen; Rückmeldung 2026-10-05). --}}
<div class="row item combat-weapon dsa5h-short-weapon" data-item-id="{{item._id}}"><span class="dsa5h-item-image {{item.system.damageToolTip.css}}" data-tooltip="{{item.system.damageToolTip.msg}}"><img src="{{item.img}}" alt="">{{#if item.structureMax}}<meter min="0" max="{{item.structureMax}}" value="{{item.structureCurrent}}"></meter>{{/if}}</span>
<span class="withContext"><a data-action="itemEdit" data-tooltip="{{item.name}}">{{item.name}}</a>{{> "modules/dsa5-helpers/templates/actors/parts/combatskill-link.hbs" item=item plain=true}}</span>
<span class="dsa5h-short-dice"><button type="button" class="dsa5h-combat-die dsa5h-die-attack" data-action="chRollCombat" data-mode="attack" title="{{#if ranged}}{{localize 'CHARAbbrev.FK'}}{{else}}{{localize 'CHARAbbrev.AT'}}{{/if}}" aria-label="{{#if ranged}}{{localize 'DSA5HELPERS.RollRangedWith' name=item.name}}{{else}}{{localize 'DSA5HELPERS.RollAttackWith' name=item.name}}{{/if}}">{{item.attack}}</button>{{#unless ranged}}<button type="button" class="dsa5h-combat-die dsa5h-die-parry" data-action="chRollCombat" data-mode="parry" title="{{localize 'CHARAbbrev.PA'}}" aria-label="{{localize 'DSA5HELPERS.RollParryWith' name=item.name}}">{{item.parry}}</button>{{/unless}}</span>
<button type="button" class="dsa5h-damage" data-action="chRollCombat" data-mode="damage" title="{{localize 'CHARAbbrev.damage'}}" aria-label="{{localize 'DSA5HELPERS.RollDamageOf' name=item.name}}">{{item.damagedie}}{{item.damageAdd}}</button><span>{{#if equip}}<button type="button" class="dsa5h-equip-toggle" data-action="dsa5hEquip" data-tooltip="DSA5HELPERS.EquipGripHint" aria-label="{{localize 'SHEET.EquipItem'}}" aria-pressed="{{#if item.system.worn.value}}true{{else}}false{{/if}}">{{> "modules/dsa5-helpers/templates/actors/parts/icon-equip.hbs"}}</button>{{/if}}</span>{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=item}}</div>
