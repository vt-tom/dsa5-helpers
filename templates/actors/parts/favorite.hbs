{{#if @root.owner}}<button type="button" class="dsa5h-favorite{{#if chip}} dsa5h-chip-fav{{/if}}" data-action="dsa5hFavorite" data-item-id="{{item._id}}" aria-label="{{localize 'DSA5HELPERS.FavoriteOf' name=item.name}}" aria-pressed="{{#if (lookup @root.dsa5h.favorites item._id)}}true{{else}}false{{/if}}">{{#if (lookup @root.dsa5h.favorites item._id)}}★{{else}}☆{{/if}}</button>{{/if}}