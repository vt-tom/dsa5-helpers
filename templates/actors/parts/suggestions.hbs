{{! Talent-Vorschläge auf dem Titelblatt (Nutzerwunsch 2026-10-06): sechs Karten im 2-spaltigen Raster, Auswahl per
    scripts/skill-suggestions/ (Anfragen der SL, Nutzung, Erfolgschance, Spezialist, Kampf, Steigerung, Klassiker).
    Zweizeilige Karte (Name | FW, darunter Grund | Probe), ohne Bild, der Favoritenstern direkt hinter dem Namen (Nutzerwunsch
    2026-10-06; favorisiert wandert das Talent zu den Favoriten, die hier nicht doppelt stehen) — bei zwei Spalten wäre der Name
    in der einzeiligen Favoritenkarte nur ~40 px breit. Offene Anfragen würfeln über den
    RollRequestService des Systems, damit die Chatkarte der SL das Ergebnis bekommt. }}
{{#if dsa5h.suggestions.length}}<section class="panel dsa5h-suggest"><div class="panel-title">{{localize 'DSA5HELPERS.Suggestions.Title'}}</div><div class="dsa5h-suggest-grid">{{#each dsa5h.suggestions as |entry|}}<div class="dsa5h-fav-card dsa5h-suggest-card item{{#if entry.messageId}} dsa5h-suggest-requested{{/if}}" data-item-id="{{entry.item._id}}" data-reason="{{entry.reason}}"><span class="dsa5h-suggest-name"><button type="button" class="dsa5h-fav-name" data-action="itemEdit" aria-label="{{localize 'DSA5HELPERS.OpenItem' name=entry.item.name}}">{{entry.item.name}}</button>{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=entry.item}}</span><span class="dsa5h-fav-card-value" title="{{localize 'Fw'}}">{{entry.item.system.talentValue.value}}</span><small class="dsa5h-suggest-reason">{{entry.reasonLabel}}</small><span class="dsa5h-fav-card-roll">{{#if entry.messageId}}{{> "modules/dsa5-helpers/templates/actors/parts/probe.hbs" item=entry.item action='dsa5hAnswerRequest' which=entry.messageId}}{{else}}{{> "modules/dsa5-helpers/templates/actors/parts/probe.hbs" item=entry.item}}{{/if}}</span></div>{{/each}}</div></section>{{/if}}
