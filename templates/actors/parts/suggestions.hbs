{{! Talent-Vorschläge auf dem Titelblatt (Nutzerwunsch 2026-10-06): sechs Karten im 2-spaltigen Raster, Auswahl per
    scripts/skill-suggestions/ (Anfragen der SL, Nutzung, Erfolgschance, Spezialist, Kampf, Steigerung, Klassiker).
    Zweizeilige Karte (Name | FW, darunter Grund | Probe), ohne Bild, der Favoritenstern direkt hinter dem Namen (Nutzerwunsch
    2026-10-06; favorisiert wandert das Talent zu den Favoriten, die hier nicht doppelt stehen) — bei zwei Spalten wäre der Name
    in der einzeiligen Favoritenkarte nur ~40 px breit. Offene Anfragen würfeln über den
    RollRequestService des Systems, damit die Chatkarte der SL das Ergebnis bekommt. Der Titel klappt das Panel ein und aus
    (Zustand je Benutzer, Rückmeldung 2026-10-07); eingeklappt zeigt er offene Anfragen als „N angefragt“.
    Rechts im Titel die Anzahl (− / +, je Benutzer und Held, Rückmeldung 2026-10-07), eingeklappt ausgeblendet. }}
{{#if dsa5h.suggestions.length}}<section class="panel dsa5h-suggest{{#if dsa5h.suggestionsCollapsed}} is-collapsed{{/if}}"><div class="panel-title dsa5h-suggest-head"><button type="button" class="dsa5h-suggest-toggle" data-action="dsa5hToggleSuggestions" aria-expanded="{{#if dsa5h.suggestionsCollapsed}}false{{else}}true{{/if}}"><span class="dsa5h-suggest-caret" aria-hidden="true">{{#if dsa5h.suggestionsCollapsed}}▸{{else}}▾{{/if}}</span><span class="dsa5h-suggest-title">{{localize 'DSA5HELPERS.Suggestions.Title'}}</span>{{#if dsa5h.suggestionsRequested}}<span class="dsa5h-suggest-badge">{{localize 'DSA5HELPERS.Suggestions.RequestedCount' count=dsa5h.suggestionsRequested}}</span>{{/if}}</button><span class="dsa5h-suggest-count" role="group" aria-label="{{localize 'DSA5HELPERS.Suggestions.Count'}}"><button type="button" data-action="dsa5hSuggestionCount" data-step="-2" aria-label="{{localize 'DSA5HELPERS.Suggestions.Fewer'}}" data-tooltip="DSA5HELPERS.Suggestions.Fewer"{{#unless dsa5h.suggestionsFewer}} disabled{{/unless}}>−</button><span>{{dsa5h.suggestionsCount}}</span><button type="button" data-action="dsa5hSuggestionCount" data-step="2" aria-label="{{localize 'DSA5HELPERS.Suggestions.More'}}" data-tooltip="DSA5HELPERS.Suggestions.More"{{#unless dsa5h.suggestionsMore}} disabled{{/unless}}>+</button></span></div><div class="dsa5h-suggest-grid"{{#if dsa5h.suggestionsCollapsed}} hidden{{/if}}>{{#each dsa5h.suggestions as |entry|}}<div class="dsa5h-fav-card dsa5h-suggest-card item{{#if entry.messageId}} dsa5h-suggest-requested{{/if}}" data-item-id="{{entry.item._id}}" data-reason="{{entry.reason}}"><span class="dsa5h-suggest-name"><button type="button" class="dsa5h-fav-name" data-action="itemEdit" aria-label="{{localize 'DSA5HELPERS.OpenItem' name=entry.item.name}}">{{entry.item.name}}</button>{{> "modules/dsa5-helpers/templates/actors/parts/favorite.hbs" item=entry.item}}</span><span class="dsa5h-fav-card-value" title="{{localize 'Fw'}}">{{entry.item.system.talentValue.value}}</span><small class="dsa5h-suggest-reason">{{entry.reasonLabel}}</small><span class="dsa5h-fav-card-roll">{{#if entry.messageId}}{{> "modules/dsa5-helpers/templates/actors/parts/probe.hbs" item=entry.item action='dsa5hAnswerRequest' which=entry.messageId}}{{else}}{{> "modules/dsa5-helpers/templates/actors/parts/probe.hbs" item=entry.item}}{{/if}}</span></div>{{/each}}</div></section>{{/if}}
