<div class="item dsa5h-inventory-entry" data-item-id="{{item._id}}" data-category="{{item.system.equipmentType.value}}"><div class="row dsa5h-inventory-row"><span class="dsa5h-item-image"><img src="{{item.img}}" alt="">{{#if item.structureMax}}<meter max="{{item.structureMax}}" value="{{item.structureCurrent}}"></meter>{{/if}}</span><span class="equipment-item-name withContext"><a data-action="itemEdit">{{item.name}}</a></span><span>{{#if item.toggle}}<button type="button" class="dsa5h-equip-toggle" data-action="dsa5hEquip" data-tooltip="{{#if (or (eq item.type 'meleeweapon') (eq item.type 'rangeweapon'))}}DSA5HELPERS.EquipGripHint{{else}}SHEET.EquipItem{{/if}}" aria-label="{{localize 'SHEET.EquipItem'}}" aria-pressed="{{#if item.toggleValue}}true{{else}}false{{/if}}">{{> "modules/dsa5-helpers/templates/actors/parts/icon-equip.hbs"}}</button>{{/if}}</span><button type="button" data-action="quantityClick" title="{{localize 'TT.strgx10'}}">{{item.system.quantity.value}}</button><span>{{item.system.preparedWeight}}</span><span>{{#if item.OnUseEffect}}{{> "modules/dsa5-helpers/templates/actors/parts/onuse.hbs" name=item.name}}{{/if}}<button type="button" data-action="itemContextMenu" aria-label="{{localize 'SHEET.EditItem'}}">⋮</button></span></div>
{{#if item.children}}<details><summary>{{localize 'DSA5HELPERS.Contents'}}</summary>{{#each item.children as |child|}}{{> "modules/dsa5-helpers/templates/actors/parts/inventory-row.hbs" item=child}}{{/each}}</details>{{/if}}</div>