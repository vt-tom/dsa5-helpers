<div class="dsa5h-tab" data-tab-panel="inventory" data-application-part="inventory" hidden>
<div class="dsa5h-inventory-summary"><span title="{{localize 'carrycapacity'}}">{{localize 'Weight'}}: {{prepare.totalWeight}} / {{prepare.carrycapacity}} · {{localize 'encumbrance'}} {{prepare.encumbrance}}</span><input type="search" class="gearSearch" aria-label="{{localize 'gearSearch'}}" placeholder="{{localize 'gearSearch'}}"></div>
<section class="panel"><div class="panel-title">{{localize 'Equipment.money'}}</div><div class="dsa5h-coins">{{#each prepare.money.coins}}<label class="item" data-item-id="{{_id}}"><img src="{{img}}" alt=""><span class="withContext"><a data-action="itemEdit">{{localize name}}</a></span><input class="money-change" type="number" value="{{system.quantity.value}}" aria-label="{{localize name}}" {{#unless @root.isEditable}}disabled{{/unless}}></label>{{/each}}</div></section>
{{#if dsa5h.editMode}}<div class="dsa5h-quick-actions"><button type="button" data-action="itemCreate" data-type="equipment" item-section="bags">+ {{localize 'Equipment.bags'}}</button></div>{{/if}}<div class="dsa5h-bag-tiles">{{#each dsa5h.bags as |item|}}<div class="item dsa5h-bag" data-category="bags" data-item-id="{{item._id}}"><button type="button" data-action="dsa5hBag" data-bag-id="{{item._id}}"><img src="{{item.img}}" alt=""><strong>{{item.name}}</strong><span>{{item.system.bagweight}} / {{item.system.capacity}}</span></button><span class="withContext"><a data-action="itemEdit">{{localize 'DSA5HELPERS.Edit'}}</a></span><button type="button" data-action="itemToggle" aria-label="{{localize 'SHEET.weightOnActor'}}" aria-pressed="{{#if item.toggleValue}}true{{else}}false{{/if}}">{{#if item.toggleValue}}●{{else}}○{{/if}}</button><button type="button" data-action="itemContextMenu" aria-label="{{localize 'SHEET.EditItem'}}">⋮</button>
<dialog class="dsa5h-bag-dialog" data-bag-dialog="{{item._id}}"><div class="panel-title flex"><span>{{item.name}}</span><button type="button" data-action="dsa5hCloseBag" aria-label="{{localize 'DSA5HELPERS.Close'}}">×</button></div>{{#each item.children as |child|}}{{> "modules/dsa5-helpers/templates/actors/parts/inventory-row.hbs" item=child}}{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}</dialog></div>{{/each}}</div>
{{#each dsa5h.inventory as |section|}}<section class="panel"><div class="panel-title flex"><span>{{localize (concat 'Equipment.' section.id)}}</span>{{#if @root.dsa5h.editMode}}<button type="button" data-action="itemCreate" item-section="{{section.id}}" data-type="{{section.dataType}}" aria-label="{{localize 'SHEET.addItem'}}">+</button>{{/if}}</div><div class="row-head dsa5h-inventory-row"><span></span><span>{{localize 'Name'}}</span><span>{{localize 'equipped'}}</span><span>#</span><span>{{localize 'Weight'}}</span><span></span></div>{{#each section.items as |item|}}{{> "modules/dsa5-helpers/templates/actors/parts/inventory-row.hbs" item=item}}{{else}}<p class="dsa5h-empty">{{localize 'SHEET.startDraggig'}}</p>{{/each}}</section>{{/each}}</div>