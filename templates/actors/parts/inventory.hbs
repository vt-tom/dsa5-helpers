<div class="dsa5h-tab" data-tab-panel="inventory" data-application-part="inventory" hidden>
<div class="dsa5h-inventory-cards">
<section class="panel dsa5h-money-panel"><div class="panel-title">{{localize 'Equipment.money'}}</div><div class="dsa5h-coins">{{#each prepare.money.coins}}<label class="item" data-item-id="{{_id}}" data-tooltip="{{localize name}}"><span class="withContext"><a data-action="itemEdit"><img src="{{img}}" alt="{{localize name}}"></a></span><input class="money-change" type="number" value="{{system.quantity.value}}" aria-label="{{localize name}}" {{#unless @root.editable}}disabled{{/unless}}><small aria-hidden="true">{{dsa5hInitial (localize name)}}</small></label>{{/each}}</div></section>
<section class="panel dsa5h-carry-panel" title="{{localize 'carrycapacity'}}"><div class="panel-title">{{localize 'Weight'}}</div><div class="dsa5h-carry-body"><div class="dsa5h-weight-bar{{#if (gt prepare.totalWeight prepare.carrycapacity)}} over{{/if}}"><div class="dsa5h-weight-fill" style="width:{{dsa5hPercent prepare.totalWeight prepare.carrycapacity}}%"></div></div><div class="dsa5h-carry-values"><span>{{prepare.totalWeight}} / {{prepare.carrycapacity}} {{localize 'DSA5HELPERS.WeightUnit'}}</span><span>{{localize 'encumbrance'}} {{prepare.encumbrance}}</span></div></div></section>
</div>
<div class="dsa5h-inventory-summary"><input type="search" class="gearSearch" aria-label="{{localize 'gearSearch'}}" placeholder="{{localize 'gearSearch'}}"></div>
<section class="panel dsa5h-bags-panel"><div class="panel-title flex"><span>{{localize 'Equipment.bags'}}</span>{{#if dsa5h.editMode}}<button type="button" data-action="itemCreate" data-type="equipment" item-section="bags" aria-label="{{localize 'SHEET.addItem'}}">+</button>{{/if}}</div><div class="dsa5h-bag-tiles">{{#each dsa5h.bags as |item|}}<div class="item dsa5h-bag" data-category="bags" data-item-id="{{item._id}}"><div class="dsa5h-bag-open withContext" role="button" tabindex="0" data-action="itemEdit" data-tooltip="{{localize 'DSA5HELPERS.OpenBag'}}"><img src="{{item.img}}" alt=""><span class="dsa5h-bag-info"><strong>{{item.name}}</strong><small>{{item.dsa5hFill.weight}} / {{item.dsa5hFill.capacity}} {{localize 'DSA5HELPERS.WeightUnit'}}</small></span><span class="dsa5h-weight-bar{{#if item.dsa5hFill.over}} over{{/if}}"><span class="dsa5h-weight-fill" style="width:{{dsa5hPercent item.dsa5hFill.weight item.dsa5hFill.capacity}}%"></span></span></div><span class="dsa5h-bag-actions">{{#if item.toggle}}<button type="button" class="dsa5h-equip-toggle" data-action="itemToggle" data-tooltip="SHEET.weightOnActor" aria-label="{{localize 'SHEET.EquipItem'}}" aria-pressed="{{#if item.toggleValue}}true{{else}}false{{/if}}">{{> "modules/dsa5-helpers/templates/actors/parts/icon-equip.hbs"}}</button>{{/if}}<button type="button" data-action="itemContextMenu" aria-label="{{localize 'SHEET.EditItem'}}">⋮</button></span></div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}</div></section>
{{#each dsa5h.inventory as |section|}}<section class="panel"><div class="panel-title flex"><span>{{localize (concat 'Equipment.' section.id)}}</span>{{#if @root.dsa5h.editMode}}<button type="button" data-action="itemCreate" item-section="{{section.id}}" data-type="{{section.dataType}}" aria-label="{{localize 'SHEET.addItem'}}">+</button>{{/if}}</div><div class="row-head dsa5h-inventory-row"><span></span><span class="left">{{localize 'Name'}}</span><span>{{localize 'DSA5HELPERS.Worn'}}</span><span>#</span><span>{{localize 'Weight'}}</span><span></span><span></span></div>{{#each section.items as |item|}}{{> "modules/dsa5-helpers/templates/actors/parts/inventory-row.hbs" item=item}}{{else}}<p class="dsa5h-empty">{{localize 'SHEET.startDraggig'}}</p>{{/each}}</section>{{/each}}</div>