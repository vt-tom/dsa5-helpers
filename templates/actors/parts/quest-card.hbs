{{! Ein Auftrag als Kachel (Issue #39): immer gleich groß, nur Titel, Stand der Ziele und ggf. Status; alles Weitere im Almanach (Klick). Felder aus questCard() in scripts/sheets/almanac.js. }}
<button type="button" class="dsa5h-almanac-tile dsa5h-quest-card{{#if status}} closed{{/if}}" data-action="dsa5hOpenAlmanac" data-almanac-tab="questlog" data-page-uuid="{{pageUuid}}" data-entry-key="{{key}}" data-tooltip="{{title}}"><img src="{{img}}" alt=""><span class="dsa5h-tile-text"><strong>{{title}}{{#if hidden}} <i class="fas fa-eye-slash dsa5h-muted" data-tooltip="DSA5HELPERS.Almanac.Hidden" inert></i>{{/if}}</strong>{{#if status}}<small class="dsa5h-quest-status status-{{status}}">{{localize (concat 'DSAQUESTLOG.STATUS.' status)}}</small>{{else if objectives.length}}<small>{{localize 'DSA5HELPERS.Quests.Goals' done=done total=objectives.length}}</small><span class="dsa5h-quest-progress" style="--pct:{{dsa5hPercent done objectives.length}}%"></span>{{else}}<small>{{localize 'DSAQUESTLOG.STATUS.0'}}</small>{{/if}}</span></button>
