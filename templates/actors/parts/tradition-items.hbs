<section class="panel"><div class="panel-title flex"><span>{{localize title}}</span>{{#if @root.dsa5h.editMode}}<button type="button" data-action="selectTraditionItem" data-tradition-kind="{{kind}}" aria-label="{{localize 'SHEET.addItem'}}">+</button>{{/if}}</div>
{{#each items as |item|}}<div class="item" data-item-id="{{item._id}}"><div class="row dsa5h-tradition-row"><span class="withContext"><a data-action="itemEdit">{{item.name}}</a></span><span>{{localize (concat ../prefix '.' (lookup item.system ../typeField))}}</span><span>{{#if ../showVolume}}{{item.volumeFinal}} / {{item.volume}}{{/if}}</span>{{#if @root.dsa5h.editMode}}<button type="button" data-action="traditionItemDelete" data-tradition-kind="{{../kind}}" aria-label="{{localize 'SHEET.DeleteItem'}}">×</button>{{/if}}</div>
<div class="chips">{{#each item.abilities as |ab|}}<span class="chip item" data-item-id="{{ab._id}}"><span class="withContext"><a data-action="itemEdit">{{ab.name}}</a></span>{{#if ab.AEpayable}}<button type="button" data-action="traditionPayCost" title="{{localize 'SHEET.payAECost'}}">− AsP</button>{{/if}}{{#if ab.OnUseEffect}}<button type="button" data-action="onUseItem" title="{{localize 'SHEET.onUseEffect'}}">▶</button>{{/if}}</span>{{/each}}</div></div>{{else}}<p class="dsa5h-empty">{{localize 'DSA5HELPERS.Empty'}}</p>{{/each}}</section>