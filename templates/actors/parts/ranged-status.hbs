{{! Nachladen + Zielen + Magazin einer Fernkampfwaffe (Stand aus dem System: item.LZ/progress/aimProgress/ammoMax). Gemeinsam genutzt von der Waffenzeile (weapon.hbs) und der Fernkampfhand im Reiter „Körper“ (body.hbs); Aktionen suchen die Waffe über das nächste [data-item-id]. }}
{{#if (gt item.LZ 0)}}<span class="dsa5h-reload{{#if (gte item.system.reloadTime.progress item.LZ)}} dsa5h-reload-done{{/if}}"><button type="button" class="dsa5h-reload-btn" data-action="loadWeapon" data-tooltip="{{item.title}}" aria-label="{{localize 'WEAPON.reload'}}: {{item.name}} ({{item.title}})"><span>{{#if (gte item.system.reloadTime.progress item.LZ)}}{{localize 'WEAPON.loaded'}}{{else}}{{localize 'WEAPON.reload'}}{{/if}}</span><span class="dsa5h-reload-bar" style="--lz:{{item.LZ}}" aria-hidden="true"><span style="width:{{dsa5hPercent item.system.reloadTime.progress item.LZ}}%"></span></span><span class="dsa5h-reload-count">{{item.progress}}</span></button>{{#if (gt item.system.reloadTime.progress 0)}}<button type="button" class="dsa5h-reload-reset" data-action="dsa5hReloadReset" data-tooltip="DSA5HELPERS.ReloadReset" aria-label="{{localize 'DSA5HELPERS.ReloadReset'}}: {{item.name}}">↺</button>{{/if}}</span>{{/if}}{{#if (gt item.system.aimTime.progress 0)}}<span class="dsa5h-aim{{#if (gte item.system.aimTime.progress 2)}} dsa5h-aim-done{{/if}}" data-tooltip="{{item.aimTitle}}" aria-label="{{localize 'WEAPON.aim'}}: {{item.name}} ({{item.aimTitle}})"><span>{{localize 'WEAPON.aim'}}</span><span class="dsa5h-reload-bar" style="--lz:2" aria-hidden="true"><span style="width:{{dsa5hPercent item.system.aimTime.progress 2}}%"></span></span><span class="dsa5h-reload-count">{{item.aimProgress}}</span></span>{{/if}}{{#if item.ammoMax}}<span class="dsa5h-mag"><span class="dsa5h-mag-label">{{localize 'DSA5HELPERS.Magazine'}}</span><strong>{{item.ammoCurrent}}/{{item.ammoMax}}</strong><button type="button" class="dsa5h-mag-swap" data-action="itemSwapMag" data-tooltip="SHEET.swapMag" aria-label="{{localize 'SHEET.swapMag'}}: {{item.name}}"{{#if (gte item.ammoCurrent item.ammoMax)}} aria-disabled="true"{{/if}}>⇄</button></span>{{/if}}
