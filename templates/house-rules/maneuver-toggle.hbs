{{! Schalter eines einzelnen Grundmanövers (Issue #45): SL schaltet um, Spieler sehen den Stand. Nur bei aktiver Regel wirksam. }}
{{#with (lookup @root.maneuverStates id) as |m|}}{{#if @root.isGM}}<button type="button" class="dsa5h-hr-switch dsa5h-hr-switch-small" role="switch" data-action="toggleManeuver" data-maneuver="{{../id}}" aria-checked="{{#if m.enabled}}true{{else}}false{{/if}}" aria-label="{{localize (concat 'DSA5HELPERS.HouseRules.maneuvers.' ../id '.Name')}}"><span class="dsa5h-hr-switch-track" aria-hidden="true"></span><span>{{#if m.enabled}}{{localize 'DSA5HELPERS.HouseRules.Active'}}{{else}}{{localize 'DSA5HELPERS.HouseRules.Inactive'}}{{/if}}</span></button>{{else}}<span class="dsa5h-hr-state{{#if m.enabled}} active{{/if}}">{{#if m.enabled}}{{localize 'DSA5HELPERS.HouseRules.Active'}}{{else}}{{localize 'DSA5HELPERS.HouseRules.Inactive'}}{{/if}}</span>{{/if}}{{/with}}
